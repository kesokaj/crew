#!/usr/bin/env bash
# Crew's git credential helper (design 12.6). On `get` for github.com it asks the broker for this
# sandbox's temporary GitHub token, which can only read and lasts one hour. No token is stored: the
# broker owns it. store and erase do nothing. Any failure says nothing, so git goes on without one.
set -eu
[ "${1:-}" = "get" ] || exit 0
[ -n "${CREW_CRED_BROKER:-}" ] && [ -r "${HOME}/.crew/token" ] || exit 0

host=""
while IFS='=' read -r key val; do
    [ -z "${key}" ] && break
    [ "${key}" = "host" ] && host="${val}"
done
[ "${host}" = "github.com" ] || exit 0

resp="$(curl -fsS --connect-timeout 2 --max-time 10 \
    -H "Authorization: Bearer $(tr -d '[:space:]' < "${HOME}/.crew/token")" \
    "${CREW_CRED_BROKER}/v1/git?host=github.com" 2>/dev/null || true)"
[ -n "${resp}" ] || exit 0
username="$(printf '%s' "${resp}" | jq -r '.username // empty' 2>/dev/null)"
token="$(printf '%s' "${resp}" | jq -r '.token // empty' 2>/dev/null)"
[ -n "${token}" ] || exit 0
printf 'username=%s\n' "${username:-x-access-token}"
printf 'password=%s\n' "${token}"
