# crew userprofile — environment (yours to edit).
export EDITOR=vim
export VISUAL=vim
export PAGER=less
export LESS='-R'

export GOPATH="$HOME/.go"
export NPM_CONFIG_PREFIX="$HOME/.npm-global"
export CREW_SANDBOX="${CREW_SANDBOX:-1}"
[ -d /crew/cache/gomod ] && export GOMODCACHE="${GOMODCACHE:-/crew/cache/gomod}"
[ -d /crew/cache/gocache ] && export GOCACHE="${GOCACHE:-/crew/cache/gocache}"
[ -d /crew/cache/npm ] && export npm_config_cache="${npm_config_cache:-/crew/cache/npm}"

# No telemetry from CLI tools that honor it.
export DO_NOT_TRACK=1

# Colors
command -v dircolors >/dev/null && eval "$(dircolors -b)"
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'
