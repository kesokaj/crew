load_release() { # load_release FOLDER: the images release.json names, checked by hash, then by id
    local dir="$1" line file tag id got ids
    [ -d "${dir}/images" ] || die "${dir} holds no images: the images of a card are pulled with --registry and --registry-token-file"
    no_pulled "${dir}"
    check_release "${dir}"
    while IFS='|' read -r file tag id; do
        [ "${DRY}" = 1 ] || ids="$(image_ids "${dir}/${file}" "${id}" "${tag}")" \
            || die "the image file of ${tag} is not the image release.json names; nothing more was loaded"
        run docker load --quiet --input "${dir}/${file}"
        [ "${DRY}" = 1 ] && continue
        got="$(docker image inspect --format '{{.Id}}' "${tag}" 2>/dev/null || true)"
        if ! grep -qxF -- "${got:-none}" <<<"${ids}"; then
            # A first install has no running tag: the one the load gave is taken away again.
            docker image rm "${tag}" >/dev/null 2>&1 || warn "the tag ${tag} of the refused load was not taken away"
            die "${tag} loaded as ${got:-nothing}, and release.json names ${id}"
        fi
    done < <(python3 -I -c '
import json, os, sys
d = sys.argv[1]
for img in json.load(open(os.path.join(d, "release.json")))["images"].values():
    print(img["file"] + "|" + img["tag"] + "|" + img["id"])' "${dir}")
}

# no_pulled FOLDER: a folder brought to this machine holds no pulled.json. Only a release pull writes
# one, into the copy it keeps, from what it checked; a brought one would turn off the check of the image
# files it names (security review of M17 phase 7).
no_pulled() {
    [ ! -e "$1/pulled.json" ] && [ ! -L "$1/pulled.json" ] \
        || die "$1 holds a pulled.json, which only a release pull on this machine writes: release pull brings a card, release import a whole folder"
}

# keep_release FOLDER: a copy in the data folder's releases, root's, with no link, checked again
# after the copy. A folder of that version that is there already must be the same release.
keep_release() {
    local v dst src; v="$(release_version "$1")"; dst="$(data_dir)/releases/${v}"; src="$(realpath -m -- "$1")"
    [ "${src}" = "${dst}" ] && return 0
    [ -n "${PULLED_FILE}" ] || no_pulled "$1"
    if [ -e "${dst}" ]; then
        cmp -s "$1/release.json" "${dst}/release.json" || die "another release ${v} is on this machine already; nothing was changed"
        return 0
    fi
    [ -z "$(find "$1" -type l -print -quit)" ] || die "$1 holds a link: a release folder holds files only"
    run install -d -m 0755 -o root -g root "$(dirname "${dst}")"
    # A copy a run that stopped left is root's own, under the data folder: it goes first.
    run rm -rf -- "${dst}.partial"
    run cp -r --no-preserve=ownership,mode -- "$1" "${dst}.partial"
    # What is checked is the copy, which no one else writes, not the folder it came from.
    if [ "${DRY}" = 0 ]; then
        if [ -n "$(find "${dst}.partial" -type l -print -quit)" ] || { [ -z "${PULLED_FILE}" ] && [ -e "${dst}.partial/pulled.json" ]; }; then
            rm -rf -- "${dst}.partial"
            die "$1 changed while it was copied: it holds a link, or a pulled.json, now; nothing was kept"
        fi
    fi
    # A release pull's record of what it took from the registry, which only it writes (16.12); a card
    # that brought one has it replaced.
    [ -z "${PULLED_FILE}" ] || run install -m 0644 -o root -g root -- "${PULLED_FILE}" "${dst}.partial/pulled.json"
    run chown -R root:root "${dst}.partial"
    run chmod -R u=rwX,go=rX "${dst}.partial"
    ( check_release "${dst}.partial" ) || { [ "${DRY}" = 1 ] || rm -rf -- "${dst}.partial"; die "the copy of $1 does not check; nothing was kept"; }
    run mv -- "${dst}.partial" "${dst}"
}

# ─── Another installation (16.12; D48) ──────────────────────────────────────
# A release of the main installation reaches another machine as a card, the release folder without its
# images, which the operator copies there by hand, with its images pulled from the private registry
# with a token that is used once, or as the whole folder, copied. The card is what that machine trusts:
# each image is checked against the config digest its release.json names, which every image store
# keeps, before it is pulled by the manifest that was checked.

# read_token FILE: the token file, read once, into REG_USER and REG_TOKEN. Its one line is USER:TOKEN,
# as docker login takes them. Neither is printed.
REG_USER="" REG_TOKEN="" REG_CONFIG="" PULLED_FILE="" PULLED_TAGS=()
read_token() {
    [ -n "${REGISTRY}" ] || die "--registry HOST/PATH names the registry the images are pulled from, such as ghcr.io/owner"
    [[ "${REGISTRY}" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?(/[a-z0-9]([a-z0-9._-]*[a-z0-9])?)+$ ]] \
        || die "--registry is HOST[:PORT]/PATH, such as ghcr.io/owner, in lower case"
    [ -f "$1" ] && [ -r "$1" ] && [ ! -L "$1" ] || die "--registry-token-file: $(printable "$1") is no file this user can read"
    # As given, before realpath took the link away; then root's or sudo's user's own, which no one
    # else reads (security review of M17's Close).
    [ ! -L "${REG_TOKEN_ARG:-$1}" ] || die "--registry-token-file: $(printable "${REG_TOKEN_ARG}") is a link"
    # The checks and the read are of one open file, opened with no link followed, so the file cannot
    # be swapped between them (security review of M17's Close, round 2).
    local line
    line="$(python3 -I - "$1" "${SUDO_UID:-}" 2>&1 <<'PY'
import errno, os, stat, sys
path, sudo = sys.argv[1], sys.argv[2]
try:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
except OSError as e:
    sys.exit("is a link" if e.errno == errno.ELOOP else "is no file this user can read")
st = os.fstat(fd)
if not stat.S_ISREG(st.st_mode):
    sys.exit("is no file this user can read")
if st.st_uid != os.getuid() and not (sudo and str(st.st_uid) == sudo):
    sys.exit(f"is not yours: its owner is uid {st.st_uid}")
if st.st_mode & 0o077:
    sys.exit(f"may be read by others (mode {stat.S_IMODE(st.st_mode):o}): chmod 600 it")
first = os.read(fd, 4096).split(b"\n", 1)[0].decode("utf-8", "replace")
if not first.strip():
    sys.exit("the file is empty")
print(first)
PY
)" || die "--registry-token-file: $(printable "$1") ${line}"
    line="${line%$'\r'}"
    REG_USER="${line%%:*}" REG_TOKEN="${line#*:}"
    { [ "${REG_USER}" != "${line}" ] && [ -n "${REG_USER}" ] && [ -n "${REG_TOKEN}" ]; } \
        || die "--registry-token-file holds one line, USER:TOKEN"
}

# registry_login: one docker login into a folder of mktemp, which registry_logout removes, the login
# with it; an exit on the way removes it too. The token goes to docker on its standard input.
registry_login() {
    local host="${REGISTRY%%/*}" err run d
    # In /run, beside crew-ctl's lock: a tmpfs, so a run that is killed leaves no login on a disk past
    # the next boot, and the next run removes it before its own.
    run="$(dirname -- "${CTL_LOCK}")"
    if [ "${DRY}" = 1 ]; then echo "+ docker login ${host} as ${REG_USER}, with the token on standard input, into a folder of mktemp in ${run}"; return; fi
    for d in "${run}"/crew-login.??????; do
        [ -d "${d}" ] && [ ! -L "${d}" ] && [ "$(stat -c %u -- "${d}")" = "$(id -u)" ] && rm -rf -- "${d}"
    done
    REG_CONFIG="$(mktemp -d -p "${run}" crew-login.XXXXXX)"
    trap registry_logout EXIT
    # A config that holds an entry for the registry already makes docker keep the login in it: an
    # empty one has docker look for a credential store of its own, which would keep the token after
    # this folder is gone (security review of M17 phase 7).
    ( umask 077; printf '{"auths": {"%s": {}}}\n' "${host}" > "${REG_CONFIG}/config.json" )
    if ! err="$(printf '%s\n' "${REG_TOKEN}" | docker --config "${REG_CONFIG}" login "${host}" -u "${REG_USER}" --password-stdin 2>&1 >/dev/null)"; then
        registry_logout
        die "the registry ${host} refused the login: $(printable "${err}" | tail -c 200)"
    fi
    REG_TOKEN=""
    python3 -I -c '
import json, sys
c = json.load(open(sys.argv[1]))
ok = not c.get("credsStore") and not c.get("credHelpers") and (c.get("auths", {}).get(sys.argv[2]) or {}).get("auth")
sys.exit(0 if ok else 1)' "${REG_CONFIG}/config.json" "${host}" \
        || { registry_logout; die "docker kept the login of ${host} somewhere else than its folder: the pull is refused"; }
}
registry_logout() { [ -z "${REG_CONFIG}" ] || rm -rf -- "${REG_CONFIG}"; REG_CONFIG=""; }

# resolve_image REF CONFIG: what to pull for REF, as REPO@DIGEST, when it is an image whose config digest
# is CONFIG: the manifest that was checked, an index followed to its one linux/amd64 manifest; a REF
# pinned by an index's digest, PostgreSQL's, the index itself, which Compose finds it by and whose id the
# containerd image store gives. Each digest is the hash of the bytes the registry gave, which docker pull
# checks again.
resolve_image() {
    python3 -I - "${REG_CONFIG}" "$1" "$2" <<'PY'
import hashlib, json, subprocess, sys
config_dir, ref, want = sys.argv[1], sys.argv[2], sys.argv[3]
repo = ref.rsplit("@", 1)[0]
last = repo.rsplit("/", 1)[-1]
if ":" in last:
    repo = repo[: len(repo) - len(last)] + last.split(":", 1)[0]
def raw(r):
    p = subprocess.run(["docker", "--config", config_dir, "buildx", "imagetools", "inspect", "--raw", r],
                       stdin=subprocess.DEVNULL, capture_output=True, timeout=300)
    if p.returncode != 0:
        sys.exit(f"{r}: {p.stderr.decode(errors='replace').strip()[-200:]}")
    return p.stdout, "sha256:" + hashlib.sha256(p.stdout).hexdigest()
body, digest = raw(ref)
top = digest
if "@" in ref and digest != ref.rsplit("@", 1)[1]:
    sys.exit(f"{ref}: the registry gave a manifest of another hash")
m = json.loads(body)
if "manifests" in m:
    # One manifest for exactly linux/amd64 and no other entry Docker could take for it: Docker
    # normalises a platform (case, x86_64, a variant) before it matches it (security review of M17's
    # Close, round 2). Other platforms, as PostgreSQL's index has them, stay.
    def platform(d):
        # "amd64" for exactly linux/amd64; "like" for another entry Docker could take for it once it
        # normalised it (case, x86_64, a variant, an empty field, no platform); "other" for another platform.
        p = d.get("platform") or {}
        if p == {"os": "linux", "architecture": "amd64"}:
            return "amd64"
        os_, arch = str(p.get("os", "")).lower(), str(p.get("architecture", "")).lower()
        return "like" if os_ in ("linux", "") and arch in ("amd64", "x86_64", "x86-64", "") else "other"
    amd = [d for d in m["manifests"] if platform(d) == "amd64"]
    if len(amd) != 1 or any(platform(d) == "like" for d in m["manifests"]):
        sys.exit(f"{ref} is an index with {len(amd)} manifests for exactly linux/amd64, or another Docker could take for it: Docker could take another than the one checked")
    body, digest = raw(repo + "@" + amd[0]["digest"])
    if digest != amd[0]["digest"]:
        sys.exit(f"{ref}: the registry gave a manifest of another hash than its index names")
    m = json.loads(body)
got = m.get("config", {}).get("digest", "")
if got != want:
    sys.exit(f"{ref} is the image {got[:19] or 'with no config'}, and release.json names {want[:19]}")
# An index is pulled as itself only when its digest is pinned, PostgreSQL's by the lock, which Compose
# names it by; any other image by the manifest that was checked (security review of M17 phase 7, round 2).
print(repo + "@" + (top if "@" in ref else digest))
PY
}

# pull_images CARD: each image the card's release.json names, checked by resolve_image, pulled by the
# digest it gives, given the tag release.json names, and checked again by its id; pulled.json then
# records what was taken. Crew's images come from REGISTRY/NAME:VERSION; PostgreSQL's from Docker Hub by
# the digest of the versions.lock in the card's deploy archive, which release.json names by its hash,
# since the library moves its tags. A tag that names another image already is never moved. On any
# refusal what this pull tagged is untagged.
pull_images() {
    local dir="$1" v list name tag id ref pin got had entries=()
    v="$(release_version "${dir}")"
    list="$(python3 -I - "${dir}" "${REGISTRY}" "${v}" <<'PY'
import hashlib, io, json, os, re, sys, tarfile
d, registry, v = sys.argv[1], sys.argv[2], sys.argv[3]
m = json.load(open(os.path.join(d, "release.json")))
dep = m.get("deploy") or {}
if dep.get("file") != "deploy.tar.gz" or not dep.get("sha256"):
    sys.exit("release.json names no deploy archive")
data = open(os.path.join(d, "deploy.tar.gz"), "rb").read()
if hashlib.sha256(data).hexdigest() != dep["sha256"]:
    sys.exit("the deploy archive does not have the hash release.json names")
with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tf:
    lock = tf.extractfile("versions.lock").read().decode()
pg = re.search(r"^POSTGRES_IMAGE=(postgres:[A-Za-z0-9._-]+)@(sha256:[0-9a-f]{64})$", lock, re.M)
if not pg:
    sys.exit("the deploy archive's versions.lock names no POSTGRES_IMAGE by its digest")
# The parts of a release, each by the tag Verify holds it to (internal/release).
parts = ["crew-server", "crew-caddy", "crew-runtime", "crew-updater", "postgres"]
if sorted(m["images"]) != sorted(parts):
    sys.exit("release.json names other images than a release's: " + ", ".join(sorted(m["images"]))[:200])
for name in parts:
    img = m["images"][name]
    tag, iid = img.get("tag", ""), img.get("id", "")
    want = "postgres:" if name == "postgres" else name + ":" + v
    if (tag != want if name != "postgres" else not re.fullmatch(r"postgres:[A-Za-z0-9._-]+", tag)) \
            or not re.fullmatch(r"sha256:[0-9a-f]{64}", iid):
        sys.exit("release.json names the image " + name + " as " + repr(tag)[:60] + ", not " + want + " with its id")
    if name == "postgres":
        if tag != pg.group(1):
            sys.exit(tag + " is not the image the deploy archive's versions.lock pins, " + pg.group(1))
        ref = "docker.io/library/postgres@" + pg.group(2)
    else:
        ref = registry + "/" + name + ":" + v
    print("|".join((name, tag, iid, ref)))
PY
)" || die "the card ${dir} cannot be pulled; nothing was changed"
    if [ "${DRY}" = 1 ]; then
        while IFS='|' read -r name tag id ref; do
            echo "+ docker pull ${ref} by the digest of what was checked, once its linux/amd64 config is ${id}; tag it ${tag}"
        done <<<"${list}"
        PULLED_FILE="<pulled.json of mktemp>"
        return 0
    fi
    while IFS='|' read -r name tag id ref; do
        pin="$(resolve_image "${ref}" "${id}" </dev/null)" || pull_failed "${tag} was not pulled"
        had="$(docker image inspect --format '{{.Id}}' "${tag}" 2>/dev/null </dev/null || true)"
        if [ -n "${had}" ] && [ "${had}" != "${id}" ] && [ "${had}" != "${pin#*@}" ]; then
            pull_failed "${tag} names another image on this machine already (${had:0:19}): it is not moved"
        fi
        docker --config "${REG_CONFIG}" pull --quiet "${pin}" >/dev/null </dev/null || pull_failed "${pin} could not be pulled"
        if [ -z "${had}" ]; then
            docker tag "${pin}" "${tag}" </dev/null || pull_failed "${tag} could not be given to ${pin}"
            PULLED_TAGS+=("${tag}")
        fi
        # The registry's name goes; PostgreSQL's by its digest stays, which Compose names it by.
        [ "${name}" = postgres ] || docker image rm "${pin}" >/dev/null 2>&1 </dev/null || true
        got="$(docker image inspect --format '{{.Id}}' "${tag}" 2>/dev/null </dev/null || true)"
        [ "${got}" = "${id}" ] || [ "${got}" = "${pin#*@}" ] || pull_failed "${tag} was pulled as ${got:-nothing}, and release.json names ${id}"
        entries+=("${name}|${id}|${pin#*@}|${ref}")
        log "pulled ${tag} from ${ref}"
    done <<<"${list}"
    PULLED_FILE="$(mktemp)"
    printf '%s\n' "${entries[@]}" | python3 -I -c '
import json, sys
images = {}
for line in sys.stdin.read().splitlines():
    name, config, manifest, ref = line.split("|")
    images[name] = {"config": config, "manifest": manifest, "from": ref}
json.dump({"version": sys.argv[2], "images": images}, open(sys.argv[1], "w"), indent=2)' "${PULLED_FILE}" "${v}" \
        || pull_failed "pulled.json could not be written"
}

pull_failed() { # pull_failed WHY: undoes the tags this pull gave, and stops
    local t
    for t in "${PULLED_TAGS[@]}"; do docker image rm "${t}" >/dev/null 2>&1 || warn "the tag ${t} of the refused pull was not taken away"; done
    PULLED_TAGS=()
    [ -z "${PULLED_FILE}" ] || rm -f -- "${PULLED_FILE}"
    PULLED_FILE=""
    registry_logout
    die "$1; the pull is refused, and what it tagged is taken away"
}

# own_folder DIR: DIR, resolved, when root may write into it what another machine trusts: a folder of
# root's, of whoever ran sudo, or of the caller, which others may write to only when it is sticky
# (security review of M17 phase 7).
own_folder() {
    local out own mode
    out="$(realpath -m -- "$1")"
    [ -d "${out}" ] && [ ! -L "${out}" ] || die "--out ${out} is no folder"
    own="$(stat -c %u -- "${out}")"; mode="$(stat -c %a -- "${out}")"
    [ "${own}" = 0 ] || [ "${own}" = "${SUDO_UID:-0}" ] || [ "${own}" = "$(id -u)" ] || die "${out} belongs to another user"
    if (( (8#${mode} & 8#022) != 0 && (8#${mode} & 8#1000) == 0 )); then die "others may write to ${out}, and it is not sticky"; fi
    echo "${out}"
}

# release_card VERSION: the card of a release of this machine, into --out (default .): its release
# folder without the images, to be copied to another installation (16.12).
release_card() {
    need_root
    local v="$1" src out dst f
    valid_version "${v}" || die "release card X.Y.Z [--out DIR]"
    src="$(data_dir)/releases/${v}"
    [ -f "${src}/release.json" ] || die "there is no release ${v} on this machine"
    out="$(realpath -m -- "${OUT_DIR:-.}")"; dst="${out}/${v}"
    [ -e "${dst}" ] || [ -L "${dst}" ] && die "${dst} is there already"
    [ -f "${src}/gate.json" ] || warn "${v} has no gate.json: another installation installs no release without a gate that passed"
    # The card is what another machine trusts, its crew-ctl included: it is written into a folder of
    # root's, of whoever ran sudo, or of the caller, which others may write to only when it is sticky,
    # and into a new folder of its own there first (security review of M17 phase 7).
    out="$(own_folder "${out}")"
    local partial
    if [ "${DRY}" = 1 ]; then partial="${out}/.crew-card.XXXXXX"; else partial="$(mktemp -d -p "${out}" .crew-card.XXXXXX)"; chmod 0755 "${partial}"; fi
    for f in release.json gate.json notes.md "$(python3 -I -c 'import json,sys; m=json.load(open(sys.argv[1])); print((m.get("deploy") or {}).get("file",""))' "${src}/release.json")" \
             "$(python3 -I -c 'import json,sys; m=json.load(open(sys.argv[1])); print((m.get("browser") or {}).get("file",""))' "${src}/release.json")"; do
        [ -n "${f}" ] && [ -f "${src}/${f}" ] || continue
        [[ "${f}" =~ ^[a-z0-9._-]+$ ]] || die "release.json of ${v} names the file $(printable "${f}")"
        run install -m 0644 -- "${src}/${f}" "${partial}/${f}"
    done
    run mv -T -- "${partial}" "${dst}"
    log "the card of ${v} is in ${dst}. On the other machine: unpack its deploy.tar.gz, then crew-ctl release pull (or install --from on a fresh machine) with --registry and --registry-token-file"
}

# release_pull CARD: a later release on another installation: its images pulled and checked, the card
# kept as its release folder with pulled.json. It waits for Install there (16.12).
release_pull() {
    need_root
    ctl_lock
    [ -f "${INSTALL_JSON}" ] || die "Crew is not installed: a first install pulls with install --from CARD --registry-token-file FILE"
    local dir="$1" v
    v="$(release_version "${dir}")"
    [ -e "$(data_dir)/releases/${v}" ] && die "the release ${v} is on this machine already"
    read_token "${REG_TOKEN_FILE}"
    registry_login
    pull_images "${dir}"
    registry_logout
    keep_release "${dir}"
    [ "${DRY}" = 1 ] || rm -f -- "${PULLED_FILE}"
    log "the release ${v} is on this machine; it waits for Install in Versions"
}

# release_import FOLDER: a later release on another installation from a whole folder that was copied;
# the updater loads and checks its images when it is installed. It waits for Install there (16.12).
release_import() {
    need_root
    ctl_lock
    [ -f "${INSTALL_JSON}" ] || die "Crew is not installed: a first install takes install --from FOLDER"
    local dir="$1" v
    v="$(release_version "${dir}")"
    [ -e "$(data_dir)/releases/${v}" ] && die "the release ${v} is on this machine already"
    no_pulled "${dir}"
    check_release "${dir}"
    keep_release "${dir}"
    log "the release ${v} is on this machine; it waits for Install in Versions"
}

cmd_release() {
    local how="release card X.Y.Z [--out DIR] | release pull CARD --registry HOST/PATH --registry-token-file FILE | release import FOLDER"
    [ $# = 2 ] || die "${how}"
    case "$1" in
        card) release_card "$2" ;;
        pull) [ -n "${REG_TOKEN_FILE}" ] || die "release pull needs --registry-token-file FILE"; release_pull "$(realpath -m -- "$2")" ;;
        import) release_import "$(realpath -m -- "$2")" ;;
        *) die "${how}" ;;
    esac
}

# agent_lines: the model and effort lines of each agent file at HEAD, for release.json (16.3).
agent_lines() {
    local p
    while IFS= read -r p; do
        git_repo show "HEAD:${p}" | awk -v p="${p}" 'NR==1 && $0!="---" {exit} NR>1 && $0=="---" {exit} NR>1 && /^(model|effort):/ {print "agent " p "\t" $0}'
    done < <(git_repo ls-tree -r --name-only HEAD | grep -E '^(harness|baseline)/agents/[^/]+\.md$' || true)
}

# release_notes VERSION COMMIT PREV: notes.md of a release (16.9), the commits since the release
# before, PREV, until tickets write them (M16).
release_notes() {
    local v="$1" commit="$2" prev="$3"
    # The title, given at the build, names the release on the Versions screen and the Baseline's
    # card; without one they take the first commit line (M15 on dave: commit lines read as titles).
    if [ -n "${TITLE_ARG}" ]; then echo "# Crew ${v}: ${TITLE_ARG}"; else echo "# Crew ${v}"; fi
    echo
    if [ -n "${prev}" ] && git_repo cat-file -e "${prev}^{commit}" 2>/dev/null; then
        echo "The commits since ${prev:0:12}:"; echo
        git_repo log --no-merges --format='- %s (%h)' "${prev}..${commit}"
    else
        echo "The last commits:"; echo
        git_repo log --no-merges --format='- %s (%h)' -n 30 "${commit}"
    fi
}

# write_release VERSION: the release folder of REPO's HEAD (16.1), by deploy/release.sh, the script a
# release Crew builds runs too (16.2): the commit is exported with git archive, its images are built
# from that tree and saved as files, and release.json, with the runtime image's inputs and the deploy
# archive, is written by the release's own server program. Only the notes are this script's.
write_release() { # write_release VERSION [ROOT]: into ROOT, the data folder's releases by default
    local v="$1" root="${2:-$(data_dir)/releases}" dir tmp commit tree prev out
    dir="${root}/${v}"; tmp="${root}/.${v}.partial"; tree="${root}/.${v}.tree"
    [ -e "${dir}" ] && die "the release ${v} is already on this machine: a version is built once"
    commit="$(git_repo rev-parse HEAD)"
    if [ "${DRY}" = 1 ]; then
        local lock
        lock="$(mktemp)"
        git_repo show "${commit}:versions.lock" > "${lock}" 2>/dev/null || true
        echo "+ git archive ${commit:0:12} into ${tree}"
        fetch_agy "${lock}" "<a folder of mktemp>" || { rm -f -- "${lock}"; exit 1; }
        rm -f -- "${lock}"
        echo "+ bash ${SELF_DIR}/release.sh build --tree ${tree} --version ${v} --out ${tmp} --agy <a folder of mktemp>"
        echo "+ bash ${SELF_DIR}/release.sh write --tree ${tree} --tree-tar ${tree}.tar --version ${v} --out ${tmp} --commit ${commit} --facts ${tree}.facts --machine-setup $(lock_value MACHINE_SETUP)"
        echo "+ write the release folder ${dir} of ${commit}"
        return
    fi
    log "the release folder of ${v}, from ${commit:0:12}"
    rm -rf -- "${tmp}" "${tree}" "${tree}.tar" "${tree}.facts"
    install -d -m 0755 "${root}" "${tree}"
    git_repo archive --format=tar -o "${tree}.tar" "${commit}" || die "the commit could not be exported"
    tar -xf "${tree}.tar" -C "${tree}" || die "the exported tree could not be unpacked"
    { git_repo ls-tree -r "${commit}"; agent_lines; } > "${tree}.facts"
    local agy
    agy="$(mktemp -d)"
    fetch_agy "${tree}/versions.lock" "${agy}" || { rm -rf -- "${agy}"; exit 1; }
    out="$(mktemp)"
    if bash "${SELF_DIR}/release.sh" build --tree "${tree}" --version "${v}" --out "${tmp}" --agy "${agy}" > "${out}" 2>&1; then
        rm -f "${out}"; rm -rf -- "${agy}"
    else
        tail -60 "${out}" >&2; rm -f "${out}"; rm -rf -- "${agy}"
        die "the build of ${v} failed (its last lines are above)"
    fi
    bash "${SELF_DIR}/release.sh" write --tree "${tree}" --tree-tar "${tree}.tar" --version "${v}" --out "${tmp}" \
        --commit "${commit}" --facts "${tree}.facts" --machine-setup "$(lock_value MACHINE_SETUP)" \
        || die "release.json of ${v} was not written"
    # The notes (16.9): the commits since the release before, until tickets write them (M16).
    prev="$(python3 -I - "${root}" "${v}" <<'PY' 2>/dev/null || true
import json, os, re, sys
root, v = sys.argv[1], sys.argv[2]
def key(s):
    m = re.match(r"^(\d+)\.(\d+)\.(\d+)", s)
    return tuple(int(x) for x in m.groups()) if m else (-1,)
best = None
for name in os.listdir(root):
    p = os.path.join(root, name, "release.json")
    if name.startswith(".") or not os.path.isfile(p) or key(name) >= key(v):
        continue
    if best is None or key(name) > key(best[0]):
        best = (name, json.load(open(p)).get("commit", ""))
print(best[1] if best else "")
PY
)"
    release_notes "${v}" "${commit}" "${prev}" > "${tmp}/notes.md"
    rm -rf -- "${tree}" "${tree}.tar" "${tree}.facts"
    mv -- "${tmp}" "${dir}"
    log "the release ${v} is in ${dir}"
}

# check_title TEXT: a release's title is one line of at most 120 characters, with no control,
# invisible, or direction-changing character, which could make it read as another on the Versions
# screen and GitHub's release page (security review of 0.50). Python counts characters, not bytes.
check_title() {
    [ -z "$1" ] && return 0
    local why
    why="$(python3 -I - "$1" <<'PY'
import sys, unicodedata
t = sys.argv[1]
if any(unicodedata.category(c)[0] in "CZ" and c != " " for c in t):
    print("--title is one line, with no control, invisible, or direction-changing character")
elif len(t) > 120:
    print(f"--title has {len(t)} characters: at most 120")
elif not t.strip():
    print("--title is empty")
PY
)" || die "--title could not be checked"
    [ -z "${why}" ] || die "${why}"
}

cmd_build() {
    need_root
    REPO="$(cd "${SELF_DIR}/.." && pwd)"
    [ -f "${REPO}/deploy/compose.yaml" ] || die "run build from a checkout: deploy/crew-ctl build --version X.Y.Z"
    [ -n "${VERSION_ARG}" ] || die "build needs --version X.Y.Z: a release's number is chosen, never guessed"
    [[ "${VERSION_ARG}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "${VERSION_ARG} is not X.Y.Z"
    check_title "${TITLE_ARG}"
    [ -z "$(git_repo status --porcelain)" ] || die "the checkout has changes that are not committed: a release is built from a commit"
    # --out builds a release this machine does not take: into a folder of its own, which neither the
    # updater nor Versions reads, such as the install test's (phase second) for another machine.
    if [ -n "${OUT_DIR}" ]; then
        local out; out="$(own_folder "${OUT_DIR}")"
        write_release "${VERSION_ARG}" "${out}"
        log "the release ${VERSION_ARG} is in ${out}/${VERSION_ARG}; this machine's updater does not see it"
        return
    fi
    [ -e "$(data_dir)/releases/${VERSION_ARG}" ] && die "the release ${VERSION_ARG} is already on this machine: a version is built once"
    write_release "${VERSION_ARG}"
    log "next: crew-ctl gate ${VERSION_ARG}"
}

# updater_call METHOD PATH [BODY]: one request on the updater's socket. It prints the answer, then
# its status code on a line of its own.
updater_call() {
    local args=(-sS --max-time 30 --unix-socket "${UPDATER_SOCK}" -X "$1" -w '\n%{http_code}\n')
    [ -z "${3:-}" ] || args+=(-H 'Content-Type: application/json' --data "$3")
    curl "${args[@]}" "http://updater$2" || { echo; echo 000; }
}

# follow ID: the request's steps as they come, until it ends; 0 when it is done.
follow() {
    local id="$1" seen=0 out
    for _ in $(seq 1 1800); do
        out="$(updater_call GET /status | sed '$d')"
        seen="$(printf '%s' "${out}" | python3 -I -c '
import json, sys, unicodedata
id, seen = int(sys.argv[1]), int(sys.argv[2])
# The detail of a step and the error of a request can hold output of code agents wrote: shown as
# one line of text, with no control or format character, so that no line of it passes for one of
# these (security review of the restore, rounds 1 and 2).
def text(t):
    t = t.replace("\n", " ").replace("\t", " ")
    return "".join(c for c in t if unicodedata.category(c) not in ("Cc", "Cf", "Zl", "Zp"))
try:
    st = json.load(sys.stdin)
except ValueError:
    print(seen); sys.exit(0)
req = st.get("current") if (st.get("current") or {}).get("id") == id else None
if req is None:
    req = next((r for r in st.get("requests", []) if r.get("id") == id), None)
if req is None:
    print(seen); sys.exit(0)
steps = req.get("steps") or []
for s in steps[seen:]:
    print(("  ok " if s["ok"] else "  -- ") + text(s["name"]) + ": " + text(s["detail"]), file=sys.stderr)
done = req.get("state") not in ("running", "asked")
print(len(steps) if not done else "end:" + text(req["state"]) + ":" + text(req.get("error") or ""))' "${id}" "${seen}")"
        case "${seen}" in
            end:done:*) return 0 ;;
            end:*) seen="${seen#end:}"; warn "${seen%%:*}: ${seen#*:}"; return 1 ;;
        esac
        sleep 2
    done
    die "the request ${id} did not end in an hour: crew-ctl status"
}

# ask_updater VERSION BYHAND: asks the updater to install VERSION, the same way the app does (16.4).
ask_updater() {
    local body out code id
    body="$(python3 -I -c 'import json,sys; print(json.dumps({"version": sys.argv[1], "askedBy": "crew-ctl", "byHand": sys.argv[2] == "1", "confirm": sys.argv[3]}))' \
        "$1" "$2" "${CONFIRM_GIVEN}")"
    [ "${DRY}" = 1 ] && { echo "+ ask the updater over ${UPDATER_SOCK}: POST /install ${body}"; return; }
    [ -S "${UPDATER_SOCK}" ] || die "the updater does not answer: ${UPDATER_SOCK} is not there (crew-ctl status)"
    out="$(updater_call POST /install "${body}")"
    code="$(printf '%s\n' "${out}" | tail -1)"; out="$(printf '%s\n' "${out}" | sed '$d')"
    case "${code}" in
        202) ;;
        409) die "the updater is busy with another request (crew-ctl status)" ;;
        422) die "the updater refused: $(printf '%s' "${out}" | python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("error",""))' 2>/dev/null)" ;;
        *) die "the updater answered ${code}: $(printable "${out}")" ;;
    esac
    id="$(printf '%s' "${out}" | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["id"])')"
    log "the updater took request ${id}: $1"
    follow "${id}" || die "Crew ${1} was not installed; the updater says why above"
    log "Crew $1 runs"
}

newest_release() { # newest_release: the newest release folder with a passed gate, by its number
    python3 -I - "$(data_dir)/releases" <<'PY'
import json, os, re, sys
root = sys.argv[1]
def key(s):
    m = re.match(r"^(\d+)\.(\d+)\.(\d+)$", s)
    return tuple(int(x) for x in m.groups()) if m else None
best = None
for name in os.listdir(root) if os.path.isdir(root) else []:
    if key(name) is None or not os.path.isfile(os.path.join(root, name, "gate.json")):
        continue
    try:
        if not json.load(open(os.path.join(root, name, "gate.json"))).get("passed"):
            continue
    except ValueError:
        continue
    if best is None or key(name) > key(best):
        best = name
print(best or "")
PY
}

# newer A B: whether version A is newer than B, by their numbers.
newer() {
    python3 -I - "$1" "$2" <<'PY'
import re, sys
def key(v):
    m = re.match(r"^(\d+)\.(\d+)\.(\d+)", v)
    return tuple(int(x) for x in m.groups()) if m else (-1,)
sys.exit(0 if key(sys.argv[1]) > key(sys.argv[2]) else 1)
PY
}

cmd_update() {
    need_root
    [ -f "${INSTALL_JSON}" ] || die "Crew is not installed"
    local v="${VERSION_ARG}" running
    running="$(installed_version)"
    [ -n "${v}" ] || v="$(newest_release)"
    [ -n "${v}" ] || die "there is no release that passed the gate on this machine"
    valid_version "${v}" || die "${v} is not a version"
    [ "${v}" != "${running}" ] || { log "Crew ${v} runs already"; return 0; }
    # An update goes forward; going back is crew-ctl rollback, which says so (16.5).
    newer "${v}" "${running}" || die "${v} is not newer than ${running}, which runs: crew-ctl rollback --version ${v}"
    ask_updater "${v}" 0
}

cmd_rollback() {
    need_root
    [ -f "${INSTALL_JSON}" ] || die "Crew is not installed"
    local v="${VERSION_ARG}"
    [ -n "${v}" ] || v="$(updater_state previous)"
    [ -n "${v}" ] || die "there is no version before this one: rollback --version X.Y.Z"
    valid_version "${v}" || die "${v} is not a version"
    # A version install built has no gate: root rolls back to it as a build by hand (16.10).
    local byhand=0
    [ -f "$(data_dir)/releases/${v}/gate.json" ] || byhand=1
    ask_updater "${v}" "${byhand}"
}

# install_by_hand: a release folder that did not pass the gate, given by root, after a word (16.10).
install_by_hand() {
    need_root
    local v; v="$(release_version "${FROM_DIR}")"
    log "a build by hand: ${v} from ${FROM_DIR}. It has not passed the gate; the updater still checks it beside the running version, switches, and watches"
    [ "${DRY}" = 1 ] || confirm_word install
    check_release "${FROM_DIR}"
    keep_release "${FROM_DIR}"
    if [ "${DRY}" = 0 ]; then
        python3 -I - "$(data_dir)/releases/${v}" <<'PY'
import hashlib, json, os, sys
d = sys.argv[1]
p = os.path.join(d, "release.json")
g = os.path.join(d, "gate.json")
body = open(p, "rb").read()
m = json.loads(body)
passed = False
if os.path.isfile(g):
    try:
        gate = json.load(open(g))
        passed = (gate.get("version") == m.get("version")
                  and gate.get("manifestSha256") == hashlib.sha256(body).hexdigest()
                  and gate.get("passed") is True
                  and gate.get("live", "") in ("", "passed", "skipped"))
    except Exception:
        passed = False
if not passed:
    if os.path.exists(g):
        os.remove(g)
    if not m.get("byHand"):
        m["byHand"] = True
        tmp = p + ".tmp"
        with open(tmp, "w") as f:
            json.dump(m, f, indent=2)
            f.write("\n")
        os.chmod(tmp, 0o644)
        os.replace(tmp, p)
PY
    fi
    ask_updater "${v}" 1
}

# ─── The gate (16.2; 0.48, 0.52) ────────────────────────────────────────────
# gate VERSION: the tests on the built images of a release folder. Here, make check at its commit and the
# install test on a fresh virtual machine where updates.install_test is local; then the updater, over its
# socket, the rest: the release in check mode beside the running Crew on a scratch copy of the database,
# from a spec the updater writes itself, with no Docker socket; the smoke microVM it starts; the selftest;
# and the browser tests of the screens, which only read. The updater writes gate.json, bound to the
# folder's release.json, with the live part pending: the running Crew runs the live steps and sends their
# result (16.2 step 5). Pending is never passed, and the updater installs no release without a passed gate,
# but root's build by hand.
GATE_STEPS=()
gate_step() { # gate_step NAME CMD...: runs one step of the gate, and records whether it passed
    local name="$1" out rc=0; shift
    log "the gate: ${name}"
    if [ "${DRY}" = 1 ]; then echo "+ $*"; GATE_STEPS+=("${name}|1|"); return 0; fi
    out="$("$@" 2>&1)" || rc=$?
    if [ "${rc}" = 0 ]; then printf '%s\n' "${out}" | tail -20; else printf '%s\n' "${out}" | tail -200; fi
    if [ "${rc}" = 0 ]; then GATE_STEPS+=("${name}|1|"); else GATE_STEPS+=("${name}|0|$(printf '%s' "${out}" | tail -1 | tr -d '|' | cut -c1-200)"); fi
    return "${rc}"
}

as_operator() { # as_operator CMD...: the checkout's owner, for what writes in the checkout
    local owner; owner="$(stat -c %U "${REPO}")"
    if [ "${owner}" != root ]; then sudo -u "${owner}" -- "$@"; else "$@"; fi
}

install_test_setting() { # the setting updates.install_test as the running Crew has it: local or off
    docker exec crew-server crew admin settings export 2>/dev/null | python3 -I -c '
import sys, re
text = sys.stdin.read()
m = re.search(r"^updates:\n((?:[ \t].*\n)*)", text, re.M)
v = re.search(r"^\s+install_test:\s*[\x27\x22]?(\w+)", m.group(1), re.M) if m else None
print(v.group(1) if v else "unread")'
}

# gate_body FOLDER INSTALLTEST NOTE: the gate's request to the updater, with GATE_STEPS, bound to the
# folder's release.json by its hash.
gate_body() {
    local stepfile; stepfile="$(mktemp)"
    printf '%s\n' "${GATE_STEPS[@]}" > "${stepfile}"
    python3 -I - "$1" "$2" "$3" "${stepfile}" <<'PY'
import hashlib, json, os, sys
d, itest, note, stepfile = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
body = open(os.path.join(d, "release.json"), "rb").read()
steps = []
for line in open(stepfile).read().splitlines():
    if line:
        name, ok, detail = line.split("|", 2)
        steps.append({"name": name, "ok": ok == "1", "detail": detail})
gate = {"manifestSha256": hashlib.sha256(body).hexdigest(), "steps": steps, "installTest": itest}
if note:
    gate["installTestNote"] = note
print(json.dumps({"version": json.loads(body)["version"], "askedBy": "crew-ctl", "gate": gate}))
PY
    local rc=$?
    rm -f "${stepfile}"
    return "${rc}"
}

# gate_install_test RC: the install test of a gate whose steps before it ended with RC, as ITEST and
# NOTE. Where updates.install_test is local it runs; the note says why it did not, and names the setting
# off only when it was read so (review of M16, F4).
gate_install_test() {
    ITEST="skipped" NOTE=""
    if [ "$1" != 0 ]; then NOTE="the install test did not run: an earlier step of the gate failed"; return 0; fi
    if [ "${DRY}" = 1 ]; then NOTE="the install test did not run: a dry run reads no setting"; return 0; fi
    local setting; setting="$(install_test_setting)"
    log "the gate: updates.install_test is ${setting}"
    # What the server said, when its answer could not be read.
    [ "${setting}" != unread ] || docker exec crew-server crew admin settings export 2>&1 | tail -5 >&2 || true
    case "${setting}" in
        local)
            if gate_step "the install test on a fresh virtual machine" as_operator make -C "${REPO}" install-test DISTRO=debian PHASE=cycle; then ITEST=passed
            else ITEST=failed; fi ;;
        off) NOTE="updates.install_test is off" ;;
        *)
            NOTE="the install test did not run: updates.install_test could not be read"
            GATE_STEPS+=("the setting updates.install_test|0|it could not be read") ;;
    esac
}

cmd_gate() {
    need_root
    [ -f "${INSTALL_JSON}" ] || die "the gate runs a release beside the running Crew: install Crew first"
    REPO="$(cd "${SELF_DIR}/.." && pwd)"
    [ -f "${REPO}/deploy/compose.yaml" ] || die "run gate from the checkout the release was built from"
    local v="${1:-}" dir commit head itest note rc=0 out id body
    [ -n "${v}" ] || die "gate X.Y.Z"
    valid_version "${v}" || die "${v} is not a version"
    dir="$(data_dir)/releases/${v}"
    [ "$(release_version "${dir}")" = "${v}" ] || die "no release folder ${v}"
    load_answers
    commit="$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["commit"])' "${dir}/release.json")"
    head="$(git_repo rev-parse HEAD)"
    [ "${head}" = "${commit}" ] || die "the checkout is at ${head:0:12}, and ${v} was built from ${commit:0:12}: check out that commit"
    [ -z "$(git_repo status --porcelain)" ] || die "the checkout has changes that are not committed"
    have make || die "the gate runs make check: install make on this machine first (the machine Crew runs on needs none)"
    GATE_STEPS=()
    gate_step "the images have the hashes release.json names" check_release "${dir}" || rc=1
    [ "${rc}" = 0 ] && { gate_step "make check at ${commit:0:12}" as_operator make -C "${REPO}" check || rc=1; }
    gate_install_test "${rc}"
    itest="${ITEST}" note="${NOTE}"
    body="$(gate_body "${dir}" "${itest}" "${note}")" || die "the gate's request could not be written"
    if [ "${DRY}" = 1 ]; then echo "+ ask the updater for the gate of ${v}: POST /gate ${body}"; return 0; fi
    out="$(updater_call POST /gate "${body}")"
    if [ "$(printf '%s\n' "${out}" | tail -1)" != 202 ]; then
        die "the updater refused the gate of ${v}: $(printf '%s' "${out}" | sed '$d' | cut -c1-400)"
    fi
    id="$(printf '%s\n' "${out}" | sed '$d' | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["id"])')"
    if follow "${id}"; then
        log "${v} passed the gate's steps (the install test: ${itest}). Its live steps wait for the running Crew: at once when only text changed, else after Run the live gate on Versions"
    else
        die "${v} did not pass the gate: ${dir}/gate.json says where"
    fi
}

# Proof (16.11, M1): one microVM starts with Kata's own kernel, the firewall test passes from inside
# it, the server answers behind the ingress, and a row is written and read back. From M3 also: an
# event a microVM prints is stored.
cmd_proof() {
    need_root
    [ -f "${ENV_FILE}" ] || die "Crew is not installed"
    [ -n "${A_CREW_HOSTNAME:-}" ] || load_answers
    local proof="${DEPLOY}/proof.sh" health tls=()
    [ "${DRY}" = 1 ] && { echo "+ ${proof}"; echo "+ admin proof"; echo "+ admin proof event"; return; }
    PROOF_IMAGE="$(lock_value RUNTIME_BASE_IMAGE)" bash "${proof}" || die "the sandbox proof failed"
    # Certificates that are not real ones are not checked here; their names are.
    [ "${A_CREW_TLS}" = acme ] || tls=(--insecure)
    health="$(curl -sS --max-time 15 --resolve "${A_CREW_HOSTNAME}:443:127.0.0.1" "${tls[@]}" \
        "https://${A_CREW_HOSTNAME}/healthz" 2>&1 || true)"
    [[ "${health}" == *'"database":"ok"'* ]] || die "the server does not answer behind the ingress: $(printable "${health}")"
    log "the server answers behind the ingress: $(printable "${health}")"
    admin proof
    # From M3: an event a microVM prints is stored. It needs Docker and a sandbox's network, so it
    # runs in the server's container, not in the admin's.
    docker exec crew-server crew admin proof event || die "an event a microVM printed was not stored"
}

# ─── Status (16.11) ─────────────────────────────────────────────────────────
cmd_status() {
    local installed=0 v="" c st problems=0 rows=()
    [ -f "${INSTALL_JSON}" ] && installed=1 && v="$(installed_version)"
    if [ "${installed}" = 1 ]; then
        for c in "${CONTAINERS[@]}"; do
            st="$(docker inspect -f '{{.State.Status}}{{if .State.Health}}/{{.State.Health.Status}}{{end}}' "${c}" 2>/dev/null | tail -1 || true)"
            [ -n "${st}" ] || st=absent
            case "${st}" in running|running/healthy) ;; *) problems=$((problems + 1)) ;; esac
            rows+=("${c}|${st}")
        done
        # What the updater says: its own version, the one Crew runs, and a request that is going
        # (16.4). The two versions differ from an install's Keep until the server replaces the
        # updater (16.8), which never replaces itself.
        if [ -S "${UPDATER_SOCK}" ]; then
            st="$(updater_call GET /status | sed '$d' | python3 -I -c '
import json, sys
try:
    s = json.load(sys.stdin)
except ValueError:
    print("does not answer"); sys.exit(0)
c = s.get("current")
print("is " + (s["state"].get("updater") or "?") + "; Crew runs " + (s["state"].get("running") or "?") + ("; installing " + c["version"] + " at " + c["steps"][-1]["name"] if c and c.get("steps") else ""))' 2>/dev/null || echo "does not answer")"
        else st="no socket"; fi
        case "${st}" in "is "*) ;; *) problems=$((problems + 1)) ;; esac
        rows+=("updater|${st}")
        st="$(systemctl is-active crew-firewall.timer 2>/dev/null || true)"
        [ "${st}" = active ] || problems=$((problems + 1))
        rows+=("crew-firewall.timer|${st:-absent}")
        # The restart timer (16.10) is a problem only where install put it: a machine set up before it
        # has none until install --upgrade-runtime.
        st="$(systemctl is-active crew-restart.timer 2>/dev/null || true)"
        if [ "${st}" != active ] && grep -q 'crew-restart.timer' "${INSTALL_JSON}" 2>/dev/null; then problems=$((problems + 1)); fi
        rows+=("crew-restart.timer|${st:-absent}")
        st="$(iptables -S CREW-FWD 2>/dev/null | grep -c '^-A' || true)"
        [ "${st:-0}" -gt 0 ] || problems=$((problems + 1))
        rows+=("CREW-FWD rules|${st:-0}")
        st="$(iptables -S CREW-MDL 2>/dev/null | grep -c '^-A' || true)"
        [ "${st:-0}" -gt 0 ] || problems=$((problems + 1))
        rows+=("CREW-MDL rules|${st:-0}")
    fi
    if [ "${JSON}" = 1 ]; then
        printf '%s\n' "${rows[@]}" | python3 -I -c '
import json, sys
installed, version, problems = sys.argv[1] == "1", sys.argv[2], int(sys.argv[3])
parts = {}
for line in sys.stdin.read().splitlines():
    if line:
        k, v = line.split("|", 1)
        parts[k] = v
print(json.dumps({"installed": installed, "version": version or None, "ok": installed and problems == 0, "parts": parts}, indent=2))' \
            "${installed}" "${v}" "${problems}"
    else
        if [ "${installed}" = 0 ]; then echo "Crew is not installed on this machine"
        else
            echo "Crew ${v}"
            local r; for r in "${rows[@]}"; do printf '  %-22s %s\n' "${r%%|*}" "${r#*|}"; done
        fi
    fi
    [ "${installed}" = 1 ] || return 2
    [ "${problems}" = 0 ] || return 1
}

# ─── Edit (16.11) ───────────────────────────────────────────────────────────
cmd_edit() {
    need_root
    [ -f "${ENV_FILE}" ] || die "Crew is not installed"
    [ $# -gt 0 ] || die "edit KEY=VALUE..."
    load_answers
    local kv k v
    EDITED=()
    for kv in "$@"; do
        k="${kv%%=*}"
        known_key "${k}" || die "${k} is not a key of the install file"
        case "${SECRET_KEYS}" in
            *" ${k} "*)
                # A secret on the command line is in the process list and the shell's history.
                [[ "${kv}" != *=* ]] || die "give ${k} without a value: crew-ctl edit ${k}, and it asks for it"
                ask v "${k}" secret ;;
            *)
                [[ "${kv}" == *=* ]] || die "edit KEY=VALUE, not ${kv}"
                v="${kv#*=}" ;;
        esac
        printf -v "A_${k}" '%s' "${v}"
        EDITED+=("${k}")
    done
    local problems; problems="$(check_answers)"
    [ -z "${problems}" ] || die "nothing was changed:"$'\n'"${problems}"
    for k in "${EDITED[@]}"; do v="A_${k}"; log "${k}: $(masked "${k}" "${!v}")"; done
    write_env
    write_answer_secrets
    # Compose starts again only the containers whose settings changed.
    compose up -d crew-server crew-caddy
    wait_healthy crew-server 60
}

# ─── Logs ───────────────────────────────────────────────────────────────────
cmd_logs() {
    local which="${1:-}" c
    case "${which}" in
        server) c=(crew-server) ;; ingress) c=(crew-caddy) ;; db) c=(crew-db) ;; updater) c=(crew-updater) ;;
        '') c=("${CONTAINERS[@]}") ;; *) die "logs [server|ingress|db|updater] [-f]" ;;
    esac
    if [ "${FOLLOW}" = 1 ] && [ "${#c[@]}" = 1 ]; then docker logs -f --tail 100 "${c[0]}"; return; fi
    for which in "${c[@]}"; do echo "── ${which}"; docker logs --tail 100 "${which}" 2>&1 || echo "(no such container)"; done
}

# ─── Uninstall (16.11) ──────────────────────────────────────────────────────
confirm_word() {
    local word="$1" typed=""
    if [ -n "${CONFIRM_GIVEN}" ]; then
        [ "${CONFIRM_GIVEN}" = "${word}" ] || die "--confirm ${CONFIRM_GIVEN} is not the word this level asks for; nothing was changed"
        return 0
    fi
    has_tty || die "no terminal to confirm on: pass --confirm ${word}"
    read -r -p "Type ${word} to go on: " typed < /dev/tty
    [ "${typed}" = "${word}" ] || die "nothing was changed"
}

FAILED=0
step() { "$@" || { FAILED=$((FAILED + 1)); warn "failed: $*"; }; }

drop_chain() { # drop_chain IPTABLES PARENT CHAIN: removes the jumps, then the chain
    local ipt="$1" parent="$2" chain="$3" rule
    have "${ipt}" || return 0
    "${ipt}" -w 5 -nL "${chain}" >/dev/null 2>&1 || return 0
    while IFS= read -r rule; do
        [ -n "${rule}" ] || continue
        # shellcheck disable=SC2086  # the rule's own words are the arguments
        step run "${ipt}" -w 5 -D "${parent}" ${rule}
    done < <("${ipt}" -w 5 -S "${parent}" 2>/dev/null | grep -E -- "-j ${chain}\$" | sed -E "s/^-A ${parent} //" || true)
    step run "${ipt}" -w 5 -F "${chain}"
    step run "${ipt}" -w 5 -X "${chain}"
}

# rm_tree PATH: a recursive delete only of a directory named as Crew's own, never through a link.
rm_tree() {
    local p="$1" real
    [ -e "${p}" ] || [ "${DRY}" = 1 ] || return 0
    real="$(realpath -m -- "${p}")"
    [ "${real}" = "${p}" ] || { FAILED=$((FAILED + 1)); warn "not deleting ${p}: a link or .. in the path"; return; }
    case "${p}" in
        /|/etc|/usr|/var|/var/lib|/home|/root|/opt|/usr/local|/usr/local/lib) FAILED=$((FAILED + 1)); warn "not deleting ${p}"; return ;;
    esac
    [ "${p}" = "${A_CREW_DATA_DIR:-/var/lib/crew}" ] || [ "${p}" = "${ETC_DIR}" ] || [ "${p}" = "${LIB_DIR}" ] \
        || { FAILED=$((FAILED + 1)); warn "not deleting ${p}: not one of Crew's folders"; return; }
    step run rm -rf -- "${p}"
}

uninstall_plan() {
    local level="$1"
    echo "Level ${level} of uninstall will:"
    case "${level}" in
        1) echo "  stop crew-caddy, crew-server, crew-updater, crew-db, and every sandbox, and switch the firewall's units"
           echo "  and the restart timer off"
           echo "  keep everything" ;;
        2|3) echo "  remove the services, every sandbox and its network, the firewall's rules and units, the"
             echo "  restart timer, Crew's settings of the security updates, the images of Crew, and ${LIB_DIR}" ;;
    esac
    case "${level}" in
        2) echo "  keep ${A_CREW_DATA_DIR} with the database and the backups, ${ETC_DIR}, crew-ctl, Docker, and Kata" ;;
        3) echo "  then delete ${A_CREW_DATA_DIR} with the database and the backups, ${ETC_DIR}, the user crew,"
           echo "  and crew-ctl. This cannot be undone."
           if [ "${WITH_RUNTIME}" = 1 ]; then echo "  and, where install put them in, Docker, Kata, and Crew's lines in daemon.json"
           else echo "  keep Docker and Kata"; fi ;;
    esac
    echo "Not on this machine, so not touched: the repositories and the GitHub App on GitHub, the"
    echo "sign-in client at Google, and the DNS records."
}

sandboxes() { docker ps -aq --filter label=crew.sandbox 2>/dev/null || true; }

cmd_uninstall() {
    need_root
    ctl_lock
    case "${LEVEL}" in 1|2|3) ;; *) die "uninstall --level 1, 2, or 3" ;; esac
    [ -f "${ENV_FILE}" ] || [ -f "${INSTALL_JSON}" ] || die "Crew is not installed"
    load_answers
    # The data folder is the one install recorded, whatever the install file says now.
    local recorded
    recorded="$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("data_dir",""))' "${INSTALL_JSON}" 2>/dev/null || true)"
    [ -z "${recorded}" ] || A_CREW_DATA_DIR="${recorded}"
    uninstall_plan "${LEVEL}"
    local word
    case "${LEVEL}" in 1) word=stop ;; 2) word=uninstall ;; 3) word="$(hostname -s)" ;; esac
    [ "${DRY}" = 1 ] || confirm_word "${word}"
    local ids u
    ids="$(sandboxes)"
    if [ "${LEVEL}" = 1 ]; then
        if [ -f "${LIB_DIR}/compose.yaml" ]; then step compose stop; else step run docker stop "${CONTAINERS[@]}"; fi
        # shellcheck disable=SC2086
        [ -z "${ids}" ] || step run docker stop ${ids}
        for u in "${UNITS[@]}"; do step run systemctl disable --now "${u}"; done
        log "Crew is stopped; crew-ctl install --build starts it again"
        return
    fi
    # Level 2, and the first half of level 3.
    if [ -f "${LIB_DIR}/compose.yaml" ]; then step compose down --remove-orphans
    else step run docker rm -f "${CONTAINERS[@]}"; step run docker network rm crew-db crew-ingress crew-out; fi
    # shellcheck disable=SC2086
    [ -z "${ids}" ] || step run docker rm -f ${ids}
    while IFS= read -r u; do [ -n "${u}" ] && step run docker network rm "${u}"; done \
        < <(docker network ls --format '{{.Name}}' 2>/dev/null | grep -E '^(sdb|mdl|src|lan|app|apo)-' || true)
    for u in "${UNITS[@]}"; do step run systemctl disable --now "${u}"; step run rm -f "${UNIT_DIR}/${u}"; done
    # Crew's own small files beside Docker: its place when memory runs out, and KSM (13.1); and the
    # settings of the security updates (16.10), so the machine is back to its distro's own.
    step run rm -f /etc/systemd/system/docker.service.d/50-crew-oom.conf /etc/tmpfiles.d/crew-ksm.conf "${APT_FILES[@]}"
    step run systemctl daemon-reload
    step run rm -f /usr/local/sbin/crew-firewall.sh
    drop_chain iptables INPUT CREW-IN
    drop_chain iptables DOCKER-USER CREW-FWD
    drop_chain iptables DOCKER-USER CREW-MDL
    drop_chain iptables DOCKER-USER CREW-APP
    drop_chain iptables DOCKER-USER CREW-APO
    drop_chain ip6tables INPUT CREW-IN6
    drop_chain ip6tables FORWARD CREW-FWD6
    while IFS= read -r u; do [ -n "${u}" ] && step run docker image rm "${u}"; done \
        < <(docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -E '^crew-(server|caddy|runtime|updater):' || true)
    rm_tree "${LIB_DIR}"
    # The updater's socket, which Docker made the folder of, and its lock beside it (16.11, since 0.53).
    step run rm -f "${UPDATER_SOCK}"
    step run rm -f "$(dirname "${UPDATER_SOCK}")/updater.lock"
    step run rmdir --ignore-fail-on-non-empty "$(dirname "${UPDATER_SOCK}")"
    if [ "${LEVEL}" = 3 ]; then
        local machine; machine="$(python3 -I -c 'import json,sys; print(json.dumps(json.load(open(sys.argv[1])).get("machine",{})))' "${INSTALL_JSON}" 2>/dev/null || echo '{}')"
        rm_tree "${A_CREW_DATA_DIR}"
        if [ "${WITH_RUNTIME}" = 1 ]; then uninstall_runtime "${machine}"; fi
        # /etc/crew last, after install.json was read.
        rm_tree "${ETC_DIR}"
        if [ "${DRY}" = 1 ] || id crew >/dev/null 2>&1; then step run userdel crew; fi
        step run rm -f "${SBIN_DIR}/crew-ctl"
    fi
    if [ "${FAILED}" -gt 0 ]; then die "${FAILED} step(s) failed: see the warnings above"; fi
    log "uninstall level ${LEVEL} is done"
}

uninstall_runtime() { # takes out what install.json says Crew installed, and nothing else
    local machine="$1"
    local docker kata
    docker="$(python3 -I -c 'import json,sys; print(json.loads(sys.argv[1]).get("docker",""))' "${machine}")"
    kata="$(python3 -I -c 'import json,sys; print(json.loads(sys.argv[1]).get("kata",""))' "${machine}")"
    # Every folder of Kata that Crew unpacked (/opt/kata-<version>), and 3.31's /opt/kata with its shim
    # wrapper when Crew installed it: names of Kata's shape only, one by one, never through a symlink.
    local d legacy=0
    while IFS= read -r -d '' d; do
        if [ -L "${d}" ]; then warn "a symlink, not a folder of Kata, left: ${d}"; continue; fi
        step run rm -rf "${d}"
        # What a host setup that was stopped left beside it: a half unpack, a folder renamed for removal.
        for x in "${d}.removing" "${d}".unpack.*; do
            if [ -e "${x}" ] && [ ! -L "${x}" ]; then step run rm -rf "${x}"; fi
        done
        [ "${d}" = /opt/kata ] && legacy=1
    done < <(python3 -I -c 'import json,re,sys
m = json.loads(sys.argv[1])
ds = list(m.get("kata_dirs", []))
if m.get("kata", "").startswith("installed 3.") and "/opt/kata" not in ds and "/opt/kata" not in m.get("kata_dirs_gone", []):
    ds.append("/opt/kata")
for d in ds:
    if isinstance(d, str) and re.fullmatch(r"/opt/kata(-[0-9][0-9A-Za-z.+~-]*)?", d) and ".." not in d:
        sys.stdout.write(d + "\0")
    else:
        sys.stderr.write("==> WARNING: not a folder of Kata, left: %r\n" % (d,))' "${machine}")
    if [ "${legacy}" = 1 ]; then step run rm -f /usr/local/bin/containerd-shim-mvm-v2; fi
    if [ "${DRY}" = 1 ]; then echo "+ put back the keys of daemon.json that Crew changed"
    else
        python3 -I - "${machine}" <<'PY' || FAILED=$((FAILED + 1))
import json, os, sys, tempfile
machine = json.loads(sys.argv[1])
path = "/etc/docker/daemon.json"
old = machine.get("daemon_json", {})
if old.get("__file__") == "<absent>" and os.path.exists(path):
    os.remove(path)
    try:
        os.rmdir(os.path.dirname(path))
    except OSError:
        pass
elif old and os.path.exists(path):
    cfg = json.load(open(path))
    for k, v in old.items():
        if v == "<absent>":
            cfg.pop(k, None)
        else:
            cfg[k] = v
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f, indent=4, sort_keys=True)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
PY
    fi
    local f
    for f in $(python3 -I -c 'import json,sys; m=json.loads(sys.argv[1]); print(" ".join(m.get("units",[]) + m.get("kernel_settings",[]) + [x for x in m.get("files",[]) if x.startswith("/etc/apt/")]))' "${machine}"); do
        step run rm -f "${f}"
    done
    if [[ "${docker}" == installed* ]]; then
        step run apt-get purge -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
        step run rm -f /etc/apt/sources.list.d/docker.list /etc/apt/keyrings/docker.asc
    elif [[ "${kata}" == installed* ]]; then
        step run systemctl restart docker
    fi
    # The packages the host setup added, last: this script needs python3 up to here.
    local pkgs
    pkgs="$(python3 -I -c 'import json,sys; print(" ".join(json.loads(sys.argv[1]).get("packages",[])))' "${machine}")"
    # shellcheck disable=SC2086
    [ -z "${pkgs}" ] || step run apt-get purge -y ${pkgs}
}

# ─── What crew-ctl passes on to crew admin ──────────────────────────────────
cmd_passthrough() {
    need_root
    [ -f "${ENV_FILE}" ] || die "Crew is not installed"
    case "$1" in
        migrate|backup|proof|pause|resume) admin "$1" ;;
        restore)
            [ $# = 2 ] || die "restore FILE"
            local f; f="$(realpath -- "$2")"
            [ -f "${f}" ] || die "no such file: $2"
            local dir; dir="$(env_get "${ENV_FILE}" CREW_DATA_DIR)"; dir="${dir:-/var/lib/crew}"
            [[ "${f}" == "${dir}/"* ]] || die "the backup must be in ${dir}, which crew admin sees"
            confirm_word restore
            # The server is stopped for it, so no request writes between the backup's state and its
            # own (16.9); it starts again whether the restore worked or not.
            run docker stop --time 20 crew-server
            local rc=0; admin restore "${f}" || rc=$?
            compose up -d --no-deps crew-server
            wait_healthy crew-server 120
            [ "${rc}" = 0 ] || die "the restore failed and changed nothing; the server runs on the database as it was" ;;
        settings)
            case "${2:-}" in
                export) admin settings export ;;
                import) [ $# = 3 ] || die "settings import FILE"; [ -r "$3" ] || die "cannot read $3"
                        compose run --rm -T crew-admin admin settings import - < "$3" ;;
                *) die "settings export | settings import FILE" ;;
            esac ;;
        db)
            [ "${2:-}" = shell ] || die "db shell"
            local args=(exec -it); has_tty || args=(exec -i)
            docker "${args[@]}" crew-db \
                sh -c 'PGPASSWORD="$(cat /run/secrets/db_crew_read)" exec psql -h 127.0.0.1 -U crew_read -d crew' ;;
    esac
}

# ─── The restart for security updates (16.10) ──────────────────────────────
# crew-restart.timer runs it every 15 minutes. It reads whether the machine needs a restart and asks
# the server, through Docker on the machine (20.3's two doors), which records it, says whether it is
# quiet, and writes the news before its yes. Only exit 0 of the server is a yes: the server down, the
# database that cannot be written, or any error of Docker's is no restart. A no is no failure of the
# timer's unit; a restart that fails is.
cmd_restart_if_quiet() {
    need_root
    [ -f "${ENV_FILE}" ] || { log "Crew is not installed: nothing to ask"; return 0; }
    # Without flock the lock cannot keep a restart out of an install: the unit fails, so it shows.
    [ "${DRY}" = 1 ] || have flock || die "flock is missing, so crew-ctl's lock cannot be taken: no restart is asked for"
    if ! ctl_lock nowait; then
        # A lock held for more than two hours is no install that runs: the unit fails, so it shows.
        if [ -n "$(find "${CTL_LOCK}" -mmin +120 2>/dev/null)" ]; then
            die "${CTL_LOCK} has been held for more than two hours: no restart is asked for (fuser -v ${CTL_LOCK})"
        fi
        log "an install or an uninstall runs: no restart now"; return 0
    fi
    local req=no out rc=0 seen="${CTL_LOCK%/*}/crew-restart-wanted"
    [ -e "${REBOOT_REQUIRED}" ] && req=yes
    # When a restart was first seen wanted, in /run beside the lock: the file the updates write is
    # written again by each that asks for a restart, so its time says nothing of how long it waited.
    [ ! -L "${seen}" ] || die "${seen} is a link"
    if [ "${req}" = yes ]; then [ -e "${seen}" ] || touch -- "${seen}"; else rm -f -- "${seen}"; fi
    if [ "${req}" = yes ]; then
        local pkgs; pkgs="$(tr '\n' ' ' < "${REBOOT_REQUIRED}.pkgs" 2>/dev/null | sed 's/ $//' || true)"
        log "the machine needs a restart for security updates${pkgs:+: ${pkgs}}"
    fi
    out="$(docker exec crew-server crew admin restart-check --reboot-required="${req}" 2>&1)" || rc=$?
    # The server's words, without control characters but the line ends, C1's too.
    [ -z "${out}" ] || printf '%s\n' "${out}" | tr -d '\000-\011\013-\037\177' | LC_ALL=C sed 's/\xc2[\x80-\x9f]//g' | tail -c 2000
    if [ "${req}" = yes ] && [ "${rc}" != 0 ] && [ -n "$(find "${seen}" -mmin +$((RESTART_DAYS * 24 * 60)) 2>/dev/null)" ]; then
        # The server's no, or no answer, for longer than the 7 days it waits for quiet hours: its own
        # record of the wait may be gone with an error, so the unit fails, and it shows.
        die "the machine has needed a restart for security updates for more than ${RESTART_DAYS} days (since $(date -r "${seen}" '+%F %R')), and Crew's server did not say yes"
    fi
    if [ "${req}" != yes ] || [ "${rc}" != 0 ]; then return 0; fi
    log "restarting the machine"
    run systemctl reboot || die "systemctl reboot failed"
}

# ─── Projects: written out as a folder, and read back (design 6.2) ──────────
# The server's container has the repositories, so crew admin runs there; the folder is on the
# machine, and travels to and from it as a tar stream.
cmd_project() {
    need_root
    [ -f "${ENV_FILE}" ] || die "Crew is not installed"
    case "${1:-}" in
        ls) [ $# = 1 ] || die "project ls"
            docker exec crew-server crew admin project ls ;;
        export)
            [ $# = 3 ] || die "project export NAME DIR"
            local name="$2" dir="$3"
            [[ "${name}" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || die "${name} is not a project's name"
            [ -L "${dir}" ] && die "${dir} is a link"
            if [ -e "${dir}" ]; then
                [ -d "${dir}" ] && [ -z "$(ls -A -- "${dir}" 2>/dev/null)" ] || die "${dir} is not an empty folder"
                # Root writes the export: into a folder of root's, or of whoever ran sudo, only.
                local owner; owner="$(stat -c %u -- "${dir}")"
                [ "${owner}" = 0 ] || [ "${owner}" = "${SUDO_UID:-0}" ] || [ "${owner}" = "$(id -u)" ] \
                    || die "${dir} belongs to another user"
            fi
            [ "${DRY}" = 1 ] && { echo "would write ${name} into ${dir}"; return 0; }
            # It is unpacked into a new folder of its own beside DIR, which no one else can reach while
            # it is written, and then moved into place.
            local parent tmp pown pmode; parent="$(dirname -- "${dir}")"
            mkdir -p -- "${parent}"
            # The new folder is made in DIR's parent, so no one else may replace it there: the parent
            # belongs to root, to whoever ran sudo, or to the caller, and if others may write to it, it
            # is sticky, as /tmp is.
            pown="$(stat -c %u -- "${parent}")"; pmode="$(stat -c %a -- "${parent}")"
            [ "${pown}" = 0 ] || [ "${pown}" = "${SUDO_UID:-0}" ] || [ "${pown}" = "$(id -u)" ] \
                || die "${parent} belongs to another user"
            if (( (8#${pmode} & 8#022) != 0 && (8#${pmode} & 8#1000) == 0 )); then
                die "others may write to ${parent}, and it is not sticky"
            fi
            tmp="$(mktemp -d -p "${parent}" .crew-export.XXXXXX)"
            if ! docker exec crew-server crew admin project export "${name}" | tar -x -C "${tmp}" --no-same-owner --no-same-permissions; then
                rm -rf -- "${tmp}"
                die "the export of ${name} failed; nothing was written to ${dir}"
            fi
            chmod 0700 -- "${tmp}"
            [ -d "${dir}" ] && rmdir -- "${dir}"
            mv -T -- "${tmp}" "${dir}"
            echo "${name} is written out to ${dir}" ;;
        import)
            [ $# = 2 ] || die "project import DIR [--name NAME] [--key KEY]"
            local dir="$2" extra=()
            [ -f "${dir}/project.md" ] || die "${dir} holds no project.md: not an export"
            [ -n "${PROJECT_NAME}" ] && extra+=(--name "${PROJECT_NAME}")
            [ -n "${PROJECT_KEY}" ] && extra+=(--key "${PROJECT_KEY}")
            [ "${DRY}" = 1 ] && { echo "would import ${dir} ${extra[*]}"; return 0; }
            tar -c -C "${dir}" . | docker exec -i crew-server crew admin project import - "${extra[@]}" ;;
        *) die "project ls | project export NAME DIR | project import DIR [--name NAME] [--key KEY]" ;;
    esac
}

usage() { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
    local verb="" args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run) DRY=1 ;;
            --yes) YES=1 ;;
            --json) JSON=1 ;;
            --confirm) CONFIRM_GIVEN="${2:?--confirm WORD}"; shift ;;
            --env-file) ENV_IN="${2:?--env-file FILE}"; shift ;;
            --build) BUILD=1 ;;
            --upgrade-runtime) UPGRADE=1 ;;
            --deploy-files) DEPLOY_FILES=1 ;;
            --from) FROM_DIR="$(realpath -m -- "${2:?--from FOLDER}")"; shift ;;
            --registry) REGISTRY="${2:?--registry HOST/PATH}"; shift ;;
            --registry-token-file) REG_TOKEN_ARG="${2:?--registry-token-file FILE}"; REG_TOKEN_FILE="$(realpath -m -- "$2")"; shift ;;
            --out) OUT_DIR="${2:?--out DIR}"; shift ;;
            --version) VERSION_ARG="${2:?--version X.Y.Z}"; shift ;;
            --title) TITLE_ARG="${2?--title TEXT}"; shift ;;
            --level) LEVEL="${2:?--level N}"; shift ;;
            --with-runtime) WITH_RUNTIME=1 ;;
            -f|--follow) FOLLOW=1 ;;
            --name) PROJECT_NAME="${2:?--name NAME}"; shift ;;
            --key) PROJECT_KEY="${2:?--key KEY}"; shift ;;
            -h|--help|help) usage; return 0 ;;
            -*) die "unknown flag $1" ;;
            *) if [ -z "${verb}" ]; then verb="$1"; else args+=("$1"); fi ;;
        esac
        shift
    done
    # crew-ctl and its files are root's, and an update does not replace them: every run says when they
    # are not the running release's (16.11, since 0.55).
    case "${verb}" in ''|install|uninstall|restart-if-quiet) ;; *) deploy_files_behind ;; esac
    case "${verb}" in
        doctor) cmd_doctor ;;
        install) cmd_install ;;
        build) cmd_build ;;
        gate) cmd_gate "${args[@]}" ;;
        update) cmd_update ;;
        rollback) cmd_rollback ;;
        status) cmd_status ;;
        edit) cmd_edit "${args[@]}" ;;
        logs) cmd_logs "${args[@]}" ;;
        uninstall) cmd_uninstall ;;
        proof) cmd_proof ;;
        migrate|backup|restore|settings|db|pause|resume) cmd_passthrough "${verb}" "${args[@]}" ;;
        selftest) cmd_selftest ;;
        restart-if-quiet) cmd_restart_if_quiet ;;
        project) cmd_project "${args[@]}" ;;
        release) cmd_release "${args[@]}" ;;
        '') usage; return 2 ;;
        *) die "unknown verb ${verb} (crew-ctl help)" ;;
    esac
}

# Sourced by the tests, it defines the functions and runs nothing.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
