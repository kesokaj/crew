# database_sql NAME: the statements of the roles script that make the database crew, for a database of
# another name, with its privileges: the roles are there already.
database_sql() {
    sed -n "/<<'SQL'\$/,/^SQL\$/p" "${DEPLOY}/db/10-roles.sh" | sed '1d;$d' \
        | grep -v -e '^\\set ' -e '^CREATE ROLE' \
        | sed -e "s/DATABASE crew /DATABASE $1 /g" -e "s/^\\\\connect crew\$/\\\\connect $1/"
}

# selftest (16.11): one ticket on a project of its own with the fake harness, in a database of its own
# made for it, so the running server's pipeline neither sees it nor works it; the database is removed
# after it.
cmd_selftest() {
    need_root
    [ -f "${ENV_FILE}" ] || die "Crew is not installed"
    local sql rc=0
    sql="DROP DATABASE IF EXISTS crew_selftest WITH (FORCE);"$'\n'"$(database_sql crew_selftest)"
    if [ "${DRY}" = 1 ]; then printf '+ in crew-db as postgres:\n%s\n' "${sql}"
    else printf '%s\n' "${sql}" | docker exec -i crew-db psql -X -q -U postgres -d postgres -v ON_ERROR_STOP=1 -f - >/dev/null \
        || die "the selftest's database was not made"; fi
    ADMIN_ENV=(-e CREW_DB_NAME=crew_selftest)
    admin migrate && admin selftest || rc=$?
    ADMIN_ENV=()
    run docker exec crew-db psql -X -q -U postgres -d postgres -c "DROP DATABASE IF EXISTS crew_selftest WITH (FORCE)" >/dev/null \
        || warn "the selftest's database crew_selftest was not removed"
    return "${rc}"
}

cmd_install() {
    need_root
    ctl_lock
    # The deploy files alone (16.11, since 0.55): a release's, checked, and nothing else.
    if [ "${DEPLOY_FILES}" = 1 ]; then install_deploy_files; return 0; fi
    # A newer machine setup (16.4): the host setup runs again, from this checkout, and records its
    # number. Docker of another major version is not replaced by it; an older Kata is (13.2, since 0.68).
    if [ "${UPGRADE}" = 1 ]; then
        [ -z "${FROM_DIR}" ] || die "--upgrade-runtime installs from this checkout, not --from a folder"
        BUILD=1
    fi
    # Another machine's first install (16.12): a card, with its images pulled. The token file is read
    # once here, before anything is changed, and used once, after the host setup installed Docker.
    if [ -n "${REG_TOKEN_FILE}" ]; then
        [ -n "${FROM_DIR}" ] || die "--registry-token-file pulls the images of a card: install --from CARD"
        # One that stopped at any step, its proof included, is run again as a repair: it records no
        # version, or the card's. Another version installed here takes the updater's path.
        if [ -f "${INSTALL_JSON}" ]; then
            local had; had="$(installed_version)"
            [ -z "${had}" ] || [ "${had}" = "$(release_version "${FROM_DIR}")" ] \
                || die "Crew ${had} is installed here: release pull brings a later release"
        fi
        read_token "${REG_TOKEN_FILE}"
    fi
    [ "${BUILD}" = 1 ] || [ -n "${FROM_DIR}" ] || die "install needs --build, which builds the images from this checkout, or --from a release folder"
    [ "${BUILD}" = 0 ] || [ -z "${FROM_DIR}" ] || die "install takes --build or --from, not both"
    # On a running Crew a folder is a build by hand, which the updater installs (16.10); a card's first
    # install run again is a repair, which takes the whole path.
    if [ -n "${FROM_DIR}" ] && [ -z "${REG_TOKEN_FILE}" ] && [ -f "${INSTALL_JSON}" ] && [ -f "${LIB_DIR}/compose.yaml" ]; then
        install_by_hand; return
    fi
    REPO="$(cd "${SELF_DIR}/.." && pwd)"
    [ -f "${REPO}/deploy/compose.yaml" ] || die "run install from a checkout: deploy/crew-ctl install --build"
    local v rec
    # 1. The answers, before anything is changed.
    load_answers
    # 2. Doctor, on the machine and the answers.
    DOC_RESULTS=(); machine_checks; doctor_answers
    doctor_print || die "the doctor found the problems above; nothing was changed"
    if [ -n "${FROM_DIR}" ]; then v="$(release_version "${FROM_DIR}")"; else v="$(resolve_version "${REPO}")"; fi
    log "installing Crew ${v}"
    local had_install=0; [ -f "${INSTALL_JSON}" ] && had_install=1
    # 3. The install file.
    write_env
    record_json data_dir "${A_CREW_DATA_DIR}"
    # An update from a newer checkout takes a dump first; until the updater exists there is no other
    # way back (16.11).
    if [ "${had_install}" = 1 ] && docker ps --format '{{.Names}}' 2>/dev/null | grep -x crew-server >/dev/null; then
        log "a dump before the update"
        admin backup || die "the dump before the update failed; nothing else was changed"
    fi
    # 4 to 7. Docker, Kata, Docker's settings, the firewall, the user crew, and the data folders.
    rec="$(mktemp)"
    if [ "${DRY}" = 1 ]; then
        echo "+ host-setup.sh --record ${rec} (DOCKER_VERSION=$(lock_value DOCKER_VERSION) KATA_VERSION=$(lock_value KATA_VERSION))"
    else
        CREW_DATA_DIR="${A_CREW_DATA_DIR}" DOCKER_VERSION="$(lock_value DOCKER_VERSION)" \
        KATA_VERSION="$(lock_value KATA_VERSION)" KATA_SHA256="$(lock_value KATA_SHA256)" \
        KATA_OURS="$(kata_ours)" \
        PROOF_IMAGE="$(lock_value RUNTIME_BASE_IMAGE)" \
            bash "${REPO}/deploy/host-setup.sh" --record "${rec}"
        merge_host_record "${rec}"
    fi
    rm -f "${rec}"
    record_json machine_setup "$(lock_value MACHINE_SETUP)"
    make_secrets
    # 8. The images, built from the checkout on this machine, or loaded from a release folder. A
    # checkout with nothing uncommitted is built as its release folder, the first one (16.11).
    if [ -n "${FROM_DIR}" ] && [ -n "${REG_TOKEN_FILE}" ]; then registry_login; pull_images "${FROM_DIR}"; registry_logout
    elif [ -n "${FROM_DIR}" ]; then load_release "${FROM_DIR}"
    elif [ -z "$(git_repo status --porcelain 2>/dev/null)" ] && [ ! -e "$(data_dir)/releases/${v}" ]; then write_release "${v}"
    else build_images "${v}"; fi
    # The deploy files only once the images are there: a build that fails leaves the machine's deploy
    # files those of the release that runs, which its updater reads (the install of 0.2.12 on dave).
    copy_deploy_files
    # The restart timer runs the crew-ctl just put in place (16.10): it starts only now.
    if [ -f "${UNIT_DIR}/crew-restart.timer" ] || [ "${DRY}" = 1 ]; then
        run systemctl start crew-restart.timer || warn "crew-restart.timer did not start: systemctl status crew-restart.timer"
    fi
    # The record is for the comparison only: a failure leaves the install to go on.
    record_deploy_files || warn "the hashes of the deploy files were not recorded: crew-ctl and Versions say they differ"
    # 9. The database, the schema, then the server and the ingress.
    export CREW_VERSION="${v}"
    compose up -d crew-db
    wait_healthy crew-db 120
    admin migrate
    compose up -d --remove-orphans crew-server crew-caddy
    wait_healthy crew-server 60
    # The first release folder, so the updater has a version to go back to (16.11), and the updater.
    if [ -n "${FROM_DIR}" ]; then keep_release "${FROM_DIR}"; [ "${DRY}" = 1 ] || [ -z "${PULLED_FILE}" ] || rm -f -- "${PULLED_FILE}"
    elif [ -n "$(git_repo status --porcelain 2>/dev/null)" ]; then
        warn "no release folder for ${v}: the checkout has changes that are not committed"; fi
    write_updater_state "${v}"
    CREW_UPDATER_VERSION="${v}" compose up -d --no-deps crew-updater
    record_json version "${v}"
    record_json installed_at "$(date -u +%FT%TZ)"
    # 10. Proof.
    cmd_proof
    # 11. The address.
    log "Crew ${v} runs at https://${A_CREW_HOSTNAME}"
    [ "${A_CREW_TLS}" = internal ] || log "the Google sign-in client lists the redirect address $(redirect_address)$(apps_redirect)"
}

# ─── Releases (16.1, 16.2, 16.4, 16.10, 16.11; M14) ─────────────────────────
git_repo() { git -c safe.directory="${REPO}" -C "${REPO}" "$@"; }

valid_version() { [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-dev\.[0-9a-f]{7,40})?$ ]]; }

release_version() { # release_version FOLDER: the version its release.json names, which is its name
    local f="$1/release.json" v
    [ -f "${f}" ] || die "$1 is not a release folder: it has no release.json"
    v="$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "${f}" 2>/dev/null || true)"
    valid_version "${v}" || die "$1: release.json names no version"
    [ "$(basename "$1")" = "${v}" ] || die "$1 holds the release ${v}: its folder must be named so"
    echo "${v}"
}

# check_release FOLDER: every image file has the hash release.json names (16.4, step 2).
check_release() {
    [ "${DRY}" = 1 ] && { echo "+ check the hashes of $1/images"; return; }
    python3 -I - "$1" <<'PY' || die "$1: an image does not have the hash its release.json names; nothing was changed"
import hashlib, json, os, re, sys
d = sys.argv[1]
m = json.load(open(os.path.join(d, "release.json")))
# An image a release pull took from a registry has no file: pulled.json names the config digest the
# pull checked, which must be release.json's id (16.12, D48).
pulled = {}
if os.path.exists(os.path.join(d, "pulled.json")):
    pf = json.load(open(os.path.join(d, "pulled.json")))
    if pf.get("version") != m["version"]:
        print("pulled.json names another version", file=sys.stderr)
        sys.exit(1)
    pulled = pf.get("images", {})
for name, img in m["images"].items():
    if name in pulled:
        pl = pulled[name]
        if pl.get("config") != img["id"] or not re.fullmatch(r"sha256:[0-9a-f]{64}", pl.get("manifest", "")):
            print(f"{name}: pulled as {pl.get('config', '')[:19]}, not {img['id'][:19]}", file=sys.stderr)
            sys.exit(1)
        continue
    p = os.path.normpath(os.path.join(d, img["file"]))
    if not p.startswith(os.path.normpath(d) + os.sep):
        sys.exit(1)
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    if h.hexdigest() != img["sha256"]:
        print(f"{name}: {h.hexdigest()[:12]}, not {img['sha256'][:12]}", file=sys.stderr)
        sys.exit(1)
PY
}

# image_ids FILE ID TAG: the ids Docker may give the image of a file docker save wrote, one a line: its
# config digest, which release.json names as ID, and each manifest of the file's index.json that names
# that config, which is the id the containerd image store gives (D48). It fails when the file holds
# another image, or names another tag than TAG, which its load would give too, as the updater's Load
# refuses one (RepoTags). A file that is no tar is left to docker load, which refuses it.
image_ids() {
    python3 -I - "$1" "$2" "$3" <<'PY'
import hashlib, json, posixpath, re, sys, tarfile
path, want, own = sys.argv[1], sys.argv[2], sys.argv[3]
def short(n):
    for p in ("docker.io/library/", "docker.io/"):
        if n.startswith(p):
            return n[len(p):]
    return n
try:
    tf = tarfile.open(path, "r:")
except (tarfile.TarError, OSError):
    print(want)
    sys.exit(0)
configs, index, blobs, kept, tags, seen = [], [], {}, 0, [], set()
with tf:
    for ti in tf:
        name = posixpath.normpath(ti.name.lstrip("/"))
        if name in ("manifest.json", "index.json", "repositories"):
            if name in seen or not ti.isfile() or ti.size > 1 << 20:
                sys.exit(f"{path} holds {name} twice, or as no small file")
            seen.add(name)
            doc = json.load(tf.extractfile(ti))
            if name == "manifest.json":
                configs += [e["Config"] for e in doc if e.get("Config")]
                tags += [t for e in doc for t in e.get("RepoTags") or []]
            elif name == "index.json":
                index = doc.get("manifests", [])
                for d in index:
                    a = d.get("annotations") or {}
                    if a.get("io.containerd.image.name"):
                        tags.append(short(a["io.containerd.image.name"]))
                    elif ":" in a.get("org.opencontainers.image.ref.name", ""):
                        tags.append(short(a["org.opencontainers.image.ref.name"]))
            else:
                tags += [short(r) + ":" + t for r, by in doc.items() for t in by]
        elif name.startswith("blobs/sha256/") and ti.isfile() and ti.size <= 1 << 20 and kept + ti.size <= 64 << 20:
            blobs["sha256:" + name[len("blobs/sha256/"):]] = tf.extractfile(ti).read()
            kept += ti.size
other = sorted({t for t in tags if t != own})
if other:
    sys.exit(f"{path} also names {other[0]}: a release's file names only its own tag")
if not configs:
    print(want)
    sys.exit(0)
if len(configs) != 1:
    sys.exit(f"{path} holds {len(configs)} images: a release's file holds one")
c = configs[0]
# manifest.json names the config as a path: blobs/sha256/HEX since Docker 25, HEX.json before.
if c.startswith("blobs/sha256/"):
    c = "sha256:" + c[len("blobs/sha256/"):]
elif c.endswith(".json") and "/" not in c:
    c = "sha256:" + c[:-len(".json")]
if not re.fullmatch(r"sha256:[0-9a-f]{64}", c) or c != want:
    sys.exit(f"{path} holds the image {c[:19]}, and release.json names {want[:19]}")
def platform(d):
