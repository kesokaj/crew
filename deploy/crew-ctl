#!/usr/bin/env bash
# crew-ctl: installs, checks, changes, and removes Crew on a machine (design 16.11).
#
#   sudo deploy/crew-ctl doctor [--env-file FILE] [--json]
#   sudo deploy/crew-ctl install --build [--env-file FILE]
#   sudo deploy/crew-ctl install --from FOLDER    a release folder: on a running Crew, a build by hand
#   sudo deploy/crew-ctl install --from CARD --registry HOST/PATH --registry-token-file FILE   another machine's first install (16.12)
#   sudo deploy/crew-ctl install --upgrade-runtime   the newer machine setup a release needs, from this checkout
#   sudo crew-ctl install --deploy-files [--version X.Y.Z]   crew-ctl and its files of the running release, checked
#   sudo deploy/crew-ctl build --version X.Y.Z [--title TEXT] [--out DIR]   a release folder of this checkout's commit (16.10)
#   sudo deploy/crew-ctl gate X.Y.Z               the gate on a release folder (16.2)
#   sudo crew-ctl update [--version X.Y.Z] | rollback [--version X.Y.Z] [--confirm X.Y.Z]
#   sudo crew-ctl status [--json]
#   sudo crew-ctl edit KEY=VALUE...
#   sudo crew-ctl logs [server|ingress|db|updater] [-f]
#   sudo crew-ctl uninstall --level 1|2|3 [--with-runtime]
#   sudo crew-ctl migrate | backup | restore FILE | settings export | settings import FILE | db shell | proof | selftest
#   sudo crew-ctl pause | resume      Pause all, and Resume, when the app cannot be opened (7.9)
#   sudo crew-ctl restart-if-quiet    crew-restart.timer's: restarts the machine for security updates when the server says so (16.10)
#   sudo crew-ctl project ls | project export NAME DIR | project import DIR [--name NAME] [--key KEY]
#   sudo crew-ctl release card X.Y.Z [--out DIR]    a release without its images, for another machine (16.12)
#   sudo crew-ctl release pull CARD --registry HOST/PATH --registry-token-file FILE | release import FOLDER
#
# Every verb takes --dry-run, which prints each command that would change something and runs none.
# --yes takes the defaults, and --confirm WORD gives the word a destructive step asks for.
#
# It does the machine's part. Crew's data is read and written only by `crew admin`, which this
# script runs in a container of the server's image (16.11). It needs only bash, coreutils, and
# python3 for JSON, which the host setup installs.
set -euo pipefail
shopt -s inherit_errexit

# ─── Paths ──────────────────────────────────────────────────────────────────
# Overridable for the tests only: under sudo -E a path in the environment would otherwise choose
# what root writes and deletes, so outside the tests an override is refused.
ETC_DIR="${CREW_CTL_ETC_DIR:-/etc/crew}"
LIB_DIR="${CREW_CTL_LIB_DIR:-/usr/local/lib/crew}"
SBIN_DIR="${CREW_CTL_SBIN_DIR:-/usr/local/sbin}"
UNIT_DIR="${CREW_CTL_UNIT_DIR:-/etc/systemd/system}"
# The updater's socket (16.11): only root and the server's container open it.
UPDATER_SOCK="${CREW_CTL_UPDATER_SOCK:-/run/crew/updater.sock}"
# What a kernel update writes when the machine needs a restart (16.10), and the lock an install and an
# uninstall hold, so the timer's restart never comes in the middle of one. It is in /run itself, where
# only root makes files: in /run/lock any user could hold it, and silence the restart (security review
# of 398035b..31089ee).
REBOOT_REQUIRED="${CREW_CTL_REBOOT_REQUIRED:-/var/run/reboot-required}"
CTL_LOCK="${CREW_CTL_LOCK:-/run/crew-ctl.lock}"
# A restart that waited longer than this, a day past the server's 7 (16.10), fails restart-if-quiet.
RESTART_DAYS=8
if [ "${CREW_CTL_TEST:-}" != 1 ]; then
    for _ov in CREW_CTL_ETC_DIR CREW_CTL_LIB_DIR CREW_CTL_SBIN_DIR CREW_CTL_UNIT_DIR CREW_CTL_UPDATER_SOCK CREW_CTL_REBOOT_REQUIRED CREW_CTL_LOCK; do
        [ -z "${!_ov:-}" ] || { echo "crew-ctl: ERROR ${_ov} is for the tests only; unset it" >&2; exit 1; }
    done
fi
ENV_FILE="${ETC_DIR}/crew.env"
SECRETS_DIR="${ETC_DIR}/secrets"
INSTALL_JSON="${ETC_DIR}/install.json"
SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# Run from a checkout, the deploy files are beside this script; installed, they are in LIB_DIR.
if [ -f "${SELF_DIR}/compose.yaml" ]; then DEPLOY="${SELF_DIR}"; else DEPLOY="${LIB_DIR}"; fi
# versions.lock is at the root of a checkout, and beside the deploy files once installed.
LOCK="${DEPLOY}/versions.lock"; [ -f "${LOCK}" ] || LOCK="${DEPLOY}/../versions.lock"

DRY=0 YES=0 JSON=0 CONFIRM_GIVEN="" ENV_IN="" BUILD=0 UPGRADE=0 DEPLOY_FILES=0 LEVEL="" WITH_RUNTIME=0 FOLLOW=0 PROJECT_NAME="" PROJECT_KEY=""
FROM_DIR="" VERSION_ARG="" TITLE_ARG="" REGISTRY="" REG_TOKEN_FILE="" REG_TOKEN_ARG="" OUT_DIR=""
SECRETS=(db_postgres db_crew db_crew_migrate db_crew_read ingress_token jwt_key)
# The secrets of the answers file, also written as files for the ingress's Docker secrets.
ANSWER_SECRETS=(google_client_secret:GOOGLE_CLIENT_SECRET cloudflare_api_token:CLOUDFLARE_API_TOKEN)
UNITS=(crew-firewall.service crew-firewall.timer crew-restart.service crew-restart.timer)
# The settings of the machine's own security updates that the host setup writes (16.10).
APT_FILES=(/etc/apt/apt.conf.d/52crew-unattended-upgrades /etc/apt/apt.conf.d/21crew-auto-upgrades)
CONTAINERS=(crew-caddy crew-server crew-updater crew-db)

log()  { echo "==> $*"; }
warn() { echo "==> WARNING: $*" >&2; }
die()  { echo "crew-ctl: ERROR $*" >&2; exit 1; }
# Every change goes through run(): --dry-run prints it and does nothing.
run()  { if [ "${DRY}" = 1 ]; then echo "+ $*"; else "$@"; fi; }
# In the tests every tool crew-ctl calls is a fake and every path a scratch folder, so they run it
# without root.
need_root() { [ "${DRY}" = 1 ] || [ "${CREW_CTL_TEST:-}" = 1 ] || [ "$(id -u)" = 0 ] || die "run as root (sudo), or pass --dry-run"; }
have() { command -v "$1" >/dev/null 2>&1; }
# ctl_lock [nowait]: holds CTL_LOCK until crew-ctl ends, and marks the time it was taken. An install
# and an uninstall wait for each other, at most 10 minutes; restart-if-quiet takes it only when it is
# free.
ctl_lock() {
    [ "${DRY}" = 1 ] && return 0
    have flock || return 0
    [ -L "${CTL_LOCK}" ] && die "${CTL_LOCK} is a link"
    local um; um="$(umask)"
    umask 077
    exec 8>>"${CTL_LOCK}" || { umask "${um}"; die "cannot open ${CTL_LOCK}"; }
    umask "${um}"
    # One that was there already is root's own, and no one else's to read or hold open again.
    [ "$(stat -L -c %u /proc/self/fd/8 2>/dev/null || stat -c %u "${CTL_LOCK}")" = "$(id -u)" ] || die "${CTL_LOCK} is not root's"
    chmod 0600 "${CTL_LOCK}"
    if [ "${1:-}" = nowait ]; then flock -n 8 || return 1
    else flock -w 600 8 || die "another crew-ctl install or uninstall has held ${CTL_LOCK} for 10 minutes"; fi
    touch "${CTL_LOCK}"
}
printable() { printf '%s' "$1" | tr -d '\000-\037\177'; }
has_tty() { ( : < /dev/tty ) 2>/dev/null; }

# ─── The answers (16.11) ────────────────────────────────────────────────────
KEYS_REQUIRED=(CREW_HOSTNAME CREW_ADMIN_EMAIL GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET)
KEYS_OPTIONAL=(CREW_APPS_DOMAIN CLOUDFLARE_API_TOKEN CREW_TLS CREW_DATA_DIR CREW_TIMEZONE CREW_SOURCE_REPO CREW_ALLOW_IP_FORWARD)
SECRET_KEYS=" GOOGLE_CLIENT_SECRET CLOUDFLARE_API_TOKEN "

is_key() { [[ "$1" =~ ^[A-Z][A-Z0-9_]*$ ]]; }
is_hostname() { [[ "$1" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$ ]] && [ "${#1}" -le 253 ]; }
is_email() { [[ "$1" =~ ^[^[:space:]@,]+@[^[:space:]@,]+\.[^[:space:]@,]+$ ]]; }
known_key() { local k; for k in "${KEYS_REQUIRED[@]}" "${KEYS_OPTIONAL[@]}"; do [ "$k" = "$1" ] && return 0; done; return 1; }
masked() { case "${SECRET_KEYS}" in *" $1 "*) [ -n "$2" ] && echo "********" || echo "" ;; *) printable "$2" ;; esac; }

# registered_domain NAME: the last two labels, or three under a public suffix of two labels.
# The address Google sends the sign-in back to. The client must list it exactly, and doctor, the
# questions, and install all say it.
redirect_address() { echo "https://auth.${A_CREW_HOSTNAME}/oauth2/google/authorization-code-callback"; }
# Hosted projects sign in at the apps domain's own portal (19.4): the client lists its address too.
apps_redirect_address() { echo "https://auth.${A_CREW_APPS_DOMAIN}/oauth2/google/authorization-code-callback"; }
apps_redirect() { [ -z "${A_CREW_APPS_DOMAIN:-}" ] || echo ", and for hosted projects $(apps_redirect_address)"; }

registered_domain() {
    local n="$1" two three
    two="$(echo "$n" | awk -F. '{print $(NF-1)"."$NF}')"
    three="$(echo "$n" | awk -F. 'NF>=3 {print $(NF-2)"."$(NF-1)"."$NF}')"
    case "${two}" in
        co.uk|org.uk|ac.uk|com.au|net.au|org.au|co.nz|co.jp|com.br|co.za|com.se) echo "${three:-$n}" ;;
        *) echo "${two}" ;;
    esac
}

# validate KEY VALUE: 0, or 1 with the reason on stderr.
validate() {
    local k="$1" v="$2"
    [[ "${v}" =~ [[:cntrl:]] ]] && { echo "${k}: control characters are refused" >&2; return 1; }
    # No $ { } \ or space: Compose reads the install file and would rewrite a value with ${.
    [[ -z "${v}" || "${v}" =~ ^[^[:space:]\$\{\}\\\'\"]+$ ]] || { echo "${k}: no spaces, quotes, \$, {, }, or \\" >&2; return 1; }
    case "${k}" in
        CREW_HOSTNAME) is_hostname "${v}" || { echo "${k}: not a host name such as crew.example.com" >&2; return 1; } ;;
        CREW_APPS_DOMAIN) [ -z "${v}" ] || is_hostname "${v}" || { echo "${k}: not a domain" >&2; return 1; } ;;
        CREW_ADMIN_EMAIL) is_email "${v}" || { echo "${k}: not a mail address" >&2; return 1; } ;;
        GOOGLE_CLIENT_ID) [ -z "${v}" ] || [[ "${v}" =~ \.apps\.googleusercontent\.com$ ]] || { echo "${k}: a Google client id ends in .apps.googleusercontent.com" >&2; return 1; } ;;
        GOOGLE_CLIENT_SECRET|CLOUDFLARE_API_TOKEN) : ;;
        CREW_TLS) case "${v}" in ''|acme|staging|internal) ;; *) echo "${k}: acme, staging, or internal" >&2; return 1 ;; esac ;;
        CREW_DATA_DIR) [ -z "${v}" ] || [[ "${v}" =~ ^/[a-zA-Z0-9._/-]+$ && "${v}" != *..* ]] || { echo "${k}: an absolute path" >&2; return 1; } ;;
        CREW_TIMEZONE) [ -z "${v}" ] || [[ "${v}" =~ ^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$ ]] || { echo "${k}: a time zone such as Europe/Stockholm" >&2; return 1; } ;;
        CREW_SOURCE_REPO) [ -z "${v}" ] || [[ "${v}" =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]] || { echo "${k}: owner/name" >&2; return 1; } ;;
        CREW_ALLOW_IP_FORWARD) case "${v}" in ''|1) ;; *) echo "${k}: 1, or empty" >&2; return 1 ;; esac ;;
        *) echo "${k}: not a key of the install file" >&2; return 1 ;;
    esac
}

env_get() { # env_get FILE KEY: the value, '' if absent; the last line wins, as for Compose
    local file="$1" key="$2"
    is_key "${key}" || die "not a key: ${key}"
    [ -f "${file}" ] || return 0
    awk -v k="${key}" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { if (v != "") print v }' "${file}"
}

# The answers, read into A_<KEY>, from --env-file, else the file an earlier install left, else asked.
load_answers() {
    local src="" k v
    if [ -n "${ENV_IN}" ]; then src="${ENV_IN}"; [ -r "${src}" ] || die "cannot read ${src}"
    elif [ -f "${ENV_FILE}" ]; then src="${ENV_FILE}"; fi
    for k in "${KEYS_REQUIRED[@]}" "${KEYS_OPTIONAL[@]}"; do
        v=""; [ -n "${src}" ] && v="$(env_get "${src}" "${k}")"
        printf -v "A_${k}" '%s' "${v}"
    done
    [ -n "${A_CREW_TLS}" ] || A_CREW_TLS=acme
    [ -n "${A_CREW_DATA_DIR}" ] || A_CREW_DATA_DIR=/var/lib/crew
    if [ -z "${src}" ]; then
        ask_answers
    fi
}

ask() { # ask VAR PROMPT [secret]
    local _var="$1" _prompt="$2" _secret="${3:-}" _v=""
    { [ "${YES}" = 1 ] || ! has_tty; } && die "no answers file: pass --env-file (see .env.example)"
    if [ -n "${_secret}" ]; then read -rs -p "${_prompt}: " _v < /dev/tty; echo; else read -r -p "${_prompt}: " _v < /dev/tty; fi
    printf -v "${_var}" '%s' "${_v}"
}

ask_answers() {
    log "no answers file: one question at a time (.env.example explains each)"
    ask A_CREW_HOSTNAME "The address Crew is opened at, such as crew.example.com"
    ask A_CREW_ADMIN_EMAIL "The Google account that may sign in"
    ask A_CREW_TLS "Certificates: acme, staging, or internal"
    [ -n "${A_CREW_TLS}" ] || A_CREW_TLS=acme
    if [ "${A_CREW_TLS}" != internal ]; then
        ask A_GOOGLE_CLIENT_ID "The Google sign-in client's id (it must list the redirect address $(redirect_address)$(apps_redirect))"
        ask A_GOOGLE_CLIENT_SECRET "The Google sign-in client's secret" secret
        ask A_CLOUDFLARE_API_TOKEN "A Cloudflare DNS token (empty: you set the DNS records yourself)" secret
    fi
}

# check_answers: every problem with the answers, as lines of "fail: ..." on stdout.
check_answers() {
    local k v
    for k in "${KEYS_REQUIRED[@]}"; do
        v="A_${k}"; v="${!v}"
        if [ -z "${v}" ]; then
            # A test machine with certificates of its own needs no sign-in client (16.11).
            case "${k}" in GOOGLE_CLIENT_*) [ "${A_CREW_TLS}" = internal ] && continue ;; esac
            echo "fail: ${k} must be given"; continue
        fi
    done
    for k in "${KEYS_REQUIRED[@]}" "${KEYS_OPTIONAL[@]}"; do
        v="A_${k}"; v="${!v}"
        [ -n "${v}" ] || continue
        validate "${k}" "${v}" 2>&1 | sed 's/^/fail: /' || true
    done
    if [ -n "${A_CREW_APPS_DOMAIN}" ] && [ -n "${A_CREW_HOSTNAME}" ]; then
        local a="${A_CREW_APPS_DOMAIN,,}" c="${A_CREW_HOSTNAME,,}"
        a="${a%.}"; c="${c%.}"
        if [ "${a}" = "${c}" ] || [[ "${c}" == *".${a}" ]] || [[ "${a}" == *".${c}" ]]; then
            echo "fail: CREW_APPS_DOMAIN must not be CREW_HOSTNAME or a domain under or over it (design 19.4); leave it empty if you do not host projects"
        fi
    fi
}

# ─── Doctor (16.11) ─────────────────────────────────────────────────────────
DOC_RESULTS=()
doc() { DOC_RESULTS+=("$1|$2|$3"); }   # doc STATUS CHECK DETAIL; STATUS is ok, warn, fail, or skip

# After uninstall level 2 the kept crew-ctl has no versions.lock: a value is then empty.
lock_value() { [ -f "${LOCK}" ] || return 0; sed -n "s/^$1=//p" "${LOCK}" | tail -1; }

doctor_machine() {
    local os="" id="" ver="" cores mem_gb disk_gb p port_users
    if [ -r /etc/os-release ]; then
        id="$(. /etc/os-release && echo "${ID:-}")"; ver="$(. /etc/os-release && echo "${VERSION_ID:-}")"
        os="$(. /etc/os-release && echo "${PRETTY_NAME:-}")"
    fi
    case "${id}" in
        debian) if [ "${ver%%.*}" -ge 13 ] 2>/dev/null; then doc ok system "${os}"; else doc fail system "${os}: Debian 13 or later"; fi ;;
        ubuntu) if [ "${ver%%.*}" -ge 24 ] 2>/dev/null; then doc ok system "${os}"; else doc fail system "${os}: Ubuntu 24.04 or later"; fi ;;
        *) doc fail system "${os:-unknown}: Crew installs on Debian or Ubuntu only" ;;
    esac
    [ "$(uname -m)" = x86_64 ] || doc fail system "$(uname -m): AMD64 only"
    if [ -e /dev/kvm ]; then doc ok virtualization "/dev/kvm present"
    else doc fail virtualization "/dev/kvm is missing: bare metal, or a virtual machine with nested virtualization"; fi

    cores="$(nproc)"
    # In GB as a label gives them (10^9 bytes): a machine sold as 64 GB passes the 64 GB line.
    mem_gb="$(awk '/MemTotal/ {printf "%d", $2*1024/1e9 + 0.5}' /proc/meminfo)"
    p="${A_CREW_DATA_DIR:-/var/lib/crew}"; while [ ! -d "${p}" ]; do p="$(dirname "${p}")"; done
    disk_gb="$(df -Pk "${p}" | awk 'NR==2 {printf "%d", $4/1024/1024}')"
    if [ "${cores}" -lt 8 ] || [ "${mem_gb}" -lt 32 ] || [ "${disk_gb}" -lt 200 ]; then
        doc fail room "${cores} threads, ${mem_gb} GB, ${disk_gb} GB free: at least 8, 32 GB, and 200 GB"
    elif [ "${cores}" -lt 16 ] || [ "${mem_gb}" -lt 64 ]; then
        doc warn room "${cores} threads, ${mem_gb} GB, ${disk_gb} GB free: below 16 and 64 GB, fewer sandboxes fit"
    else doc ok room "${cores} threads, ${mem_gb} GB, ${disk_gb} GB free"; fi

    for port in 80 443; do
        port_users="$({ ss -Hltnp "sport = :${port}" 2>/dev/null || true; } | { grep -oE 'users:\(\("[^"]+"' || true; } | sed 's/users:(("//' | sort -u | tr '\n' ' ')"
        if [ -z "${port_users}" ]; then doc ok "port ${port}" "free"
        elif [[ "${port_users}" == *docker-proxy* ]] && have docker && docker ps --format '{{.Names}}' 2>/dev/null | grep -x crew-caddy >/dev/null; then
            doc ok "port ${port}" "Crew's ingress"
        else doc fail "port ${port}" "taken by ${port_users}"; fi
    done

    local url
    for url in https://github.com https://download.docker.com https://accounts.google.com https://registry-1.docker.io/v2/; do
        if curl -sS -o /dev/null --max-time 10 "${url}" 2>/dev/null; then doc ok network "reaches ${url}"
        else doc fail network "cannot reach ${url}"; fi
    done
    local date_hdr remote now
    date_hdr="$(curl -sSI --max-time 10 https://www.google.com 2>/dev/null | tr -d '\r' | awk -F': ' 'tolower($1)=="date" {print $2}')"
    if [ -n "${date_hdr}" ] && remote="$(date -d "${date_hdr}" +%s 2>/dev/null)"; then
        now="$(date +%s)"
        if [ $(( now > remote ? now - remote : remote - now )) -gt 30 ]; then doc fail clock "off by more than 30 seconds"
        else doc ok clock "in time"; fi
    else doc warn clock "could not be compared"; fi

    # What is already there: styrman-crew's running parts fail, its leftovers warn (17.6).
    if have docker && docker ps -a --format '{{.Names}}' 2>/dev/null | grep '^styrman' >/dev/null; then
        doc fail "already there" "containers of styrman-crew"
    fi
    if have systemctl && systemctl list-unit-files 'styrman*' 2>/dev/null | grep styrman >/dev/null; then
        doc fail "already there" "units of styrman-crew"
    fi
    if have iptables && iptables -S 2>/dev/null | grep -- '-N STYRMAN' >/dev/null; then
        doc fail "already there" "firewall chains of styrman-crew"
    fi
    [ -d /var/lib/styrman ] && doc warn "already there" "styrman-crew's data folder /var/lib/styrman, left by its uninstall"

    # Docker and Kata: another major version than versions.lock fails, another minor warns.
    local want have_v
    if [ ! -f "${LOCK}" ]; then
        doc skip versions "no versions.lock here: run doctor from a checkout to compare Docker's and Kata's versions"
        return 0
    fi
    if have docker; then
        want="$(lock_value DOCKER_VERSION)"; have_v="$(docker version --format '{{.Server.Version}}' 2>/dev/null || true)"
        if [ -z "${have_v}" ]; then doc fail docker "installed, but its daemon does not answer"
        elif [ "${have_v%%.*}" != "${want%%.*}" ]; then doc fail docker "${have_v}, not ${want}'s major version: crew-ctl install --upgrade-runtime replaces it"
        elif [ "${have_v}" != "${want}" ]; then doc warn docker "${have_v}, not ${want}: left as it is"
        else doc ok docker "${have_v}"; fi
    else doc ok docker "not installed: install puts ${DOCKER_VERSION:-$(lock_value DOCKER_VERSION)} in"; fi
    doctor_kata /etc/docker/daemon.json "" /proc "$(lock_value KATA_VERSION)"
}

# doctor_kata DAEMON_JSON ROOT PROC WANT: the Kata Docker's runtime mvm starts (13.2). An older one is no
# failure: install moves it to versions.lock's, beside it, and the runtime switches after its proof
# (since 0.68). Paths are arguments for the tests.
doctor_kata() {
    local daemon="$1" root="$2" proc="$3" want="$4" have_v
    # shellcheck source=lib/kata-config.sh
    source "${DEPLOY}/lib/kata-config.sh"
    if have_v="$(kata_in_use "${daemon}" "${root}")"; then
        have_v="${have_v%% *}"
        if [ "${have_v}" = "${want}" ]; then doc ok kata "${have_v}"
        elif kata_older "${have_v}" "${want}"; then doc ok kata "${have_v}: install moves it to ${want}, beside it, and switches after its proof"
        else doc warn kata "${have_v}, newer than ${want}: left as it is"; fi
    elif [ -e "${root}/opt/kata" ] || compgen -G "${root}/opt/kata-[0-9]*" >/dev/null; then
        doc warn kata "Docker's runtime mvm starts no Kata that crew-ctl knows: install puts ${want} in"
    else doc ok kata "not installed: install puts ${want} in"; fi
    # 3.31's folder that Crew did not install, once nothing runs from it, is the operator's to remove.
    if [ -d "${root}/opt/kata" ] && ! kata_named "${daemon}" "${root}/opt/kata" "${root}" \
        && ! kata_ours | grep -xF /opt/kata >/dev/null && ! kata_busy "${root}/opt/kata" "${proc}" >/dev/null; then
        doc warn kata "/opt/kata is no longer used, and Crew did not install it: remove it by hand if nothing else needs it"
    fi
}

# kata_ours: the folders of Kata that install.json says Crew put on the machine, one per line, which the
# host setup alone may remove (13.2): those it unpacked (kata_dirs), and 3.31's /opt/kata when Crew
# installed that one. install.json is root's own; the host setup checks each line's shape again.
kata_ours() {
    [ -f "${INSTALL_JSON}" ] || return 0
    python3 -I -c 'import json,sys
m = json.load(open(sys.argv[1])).get("machine", {})
ds = [d for d in m.get("kata_dirs", []) if isinstance(d, str) and "\n" not in d]
if m.get("kata", "").startswith("installed 3.") and "/opt/kata" not in ds and "/opt/kata" not in m.get("kata_dirs_gone", []):
    ds.append("/opt/kata")
print("\n".join(ds))' "${INSTALL_JSON}" 2>/dev/null || true
}

doctor_answers() {
    local line
    while IFS= read -r line; do [ -n "${line}" ] && doc fail answers "${line#fail: }"; done < <(check_answers)
    [ "${#DOC_RESULTS[@]}" -gt 0 ] && printf '%s\n' "${DOC_RESULTS[@]}" | grep '^fail|answers' >/dev/null && return 0
    doc ok answers "every key is given and has its form"

    if [ "${A_CREW_TLS}" = internal ]; then
        doc skip names "CREW_TLS=internal: the names and the sign-in client are not checked"
        return 0
    fi
    # The names point at this machine, unless the ingress may write them.
    local ip name resolved names=("${A_CREW_HOSTNAME}" "auth.${A_CREW_HOSTNAME}")
    [ -z "${A_CREW_APPS_DOMAIN:-}" ] || names+=("auth.${A_CREW_APPS_DOMAIN}")
    ip="$(curl -sS --max-time 10 https://api.ipify.org 2>/dev/null || true)"
    for name in "${names[@]}"; do
        resolved="$(getent ahostsv4 "${name}" 2>/dev/null | awk '!f {print $1; f = 1}')"
        if [ -n "${ip}" ] && [ "${resolved}" = "${ip}" ]; then doc ok names "${name} points at this machine (${ip})"
        elif [ -n "${A_CLOUDFLARE_API_TOKEN}" ]; then doc ok names "${name} is ${resolved:-not set}: the ingress writes it with the DNS token"
        else doc fail names "${name} is ${resolved:-not set}, this machine is ${ip:-unknown}, and there is no DNS token"; fi
    done
    # The sign-in client: a made-up code is refused as a wrong code by a client Google knows, and
    # as an unknown client otherwise; then Google's sign-in page is asked with each redirect address
    # so a missing redirect address (redirect_uri_mismatch) fails here.
    local answer redirect uri redirects=() ok=1
    redirect="$(redirect_address)"
    redirects+=("${redirect}")
    [ -z "${A_CREW_APPS_DOMAIN:-}" ] || redirects+=("$(apps_redirect_address)")
    # The secret goes to curl in its configuration on standard input, never on its command line.
    answer="$(printf 'data-urlencode = "client_secret=%s"\n' "${A_GOOGLE_CLIENT_SECRET}" \
        | curl -sS --max-time 10 --config - -X POST https://oauth2.googleapis.com/token \
        --data-urlencode "code=crew-doctor-check" --data-urlencode "client_id=${A_GOOGLE_CLIENT_ID}" \
        --data-urlencode "redirect_uri=${redirect}" \
        --data-urlencode "grant_type=authorization_code" 2>/dev/null || true)"
    case "${answer}" in
        *invalid_grant*)
            local body code
            for uri in "${redirects[@]}"; do
                answer="$(curl -sSLG --max-time 10 -w $'\n%{http_code}' https://accounts.google.com/o/oauth2/v2/auth \
                    --data-urlencode "client_id=${A_GOOGLE_CLIENT_ID}" \
                    --data-urlencode "redirect_uri=${uri}" \
                    --data-urlencode "response_type=code" \
                    --data-urlencode "scope=openid email profile" 2>/dev/null || true)"
                code="${answer##*$'\n'}"
                body="${answer%$'\n'*}"
                if [[ "${body}" == *redirect_uri_mismatch* ]]; then
                    doc fail "sign-in client" "Google refuses the redirect address ${uri} (redirect_uri_mismatch): add it to the sign-in client in Google Cloud Console"
                    ok=0
                elif [[ "${code}" == 4* ]]; then
                    doc fail "sign-in client" "Google refuses the sign-in request for ${uri} (HTTP ${code})"
                    ok=0
                elif [ "${code}" != 200 ] || [ -z "${body}" ]; then
                    doc warn "sign-in client" "Google gave no answer for the redirect address ${uri}"
                    ok=0
                fi
            done
            [ "${ok}" = 0 ] || doc ok "sign-in client" "Google knows it; it lists the redirect address ${redirect}$(apps_redirect)"
            ;;
        *invalid_client*|*unauthorized_client*) doc fail "sign-in client" "Google refuses the client id or secret" ;;
        *) doc warn "sign-in client" "Google gave no answer that can be read" ;;
    esac
    if [ -n "${A_CLOUDFLARE_API_TOKEN}" ]; then
        local zone; zone="$(registered_domain "${A_CREW_HOSTNAME}")"
        answer="$(printf 'header = "Authorization: Bearer %s"\n' "${A_CLOUDFLARE_API_TOKEN}" \
            | curl -sS --max-time 10 --config - "https://api.cloudflare.com/client/v4/zones?name=${zone}" 2>/dev/null || true)"
        if [[ "${answer}" == *'"success":true'* && "${answer}" == *'"id"'* ]]; then doc ok "DNS token" "it reaches the zone ${zone}"
        else doc fail "DNS token" "it does not reach the zone ${zone}"; fi
    fi
}

doctor_print() {
    local r st check detail fails=0
    if [ "${JSON}" = 1 ]; then
        printf '%s\n' "${DOC_RESULTS[@]}" | python3 -I -c '
import json, sys
out = []
for line in sys.stdin.read().splitlines():
    st, check, detail = line.split("|", 2)
    out.append({"check": check, "status": st, "detail": detail})
print(json.dumps({"ok": not any(r["status"] == "fail" for r in out), "checks": out}, indent=2))'
    else
        for r in "${DOC_RESULTS[@]}"; do
            IFS='|' read -r st check detail <<<"${r}"
            printf '%-5s %-16s %s\n' "${st}" "${check}" "$(printable "${detail}")"
        done
    fi
    for r in "${DOC_RESULTS[@]}"; do [[ "${r}" == fail\|* ]] && fails=$((fails + 1)); done
    return $(( fails > 0 ))
}

# An installation that is there already: a repair or an update, and what is wrong with it (21: an
# install that stopped half way is run again, and goes on from where it stopped).
doctor_installed() {
    [ -f "${INSTALL_JSON}" ] || return 0
    local had done c down=()
    had="$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("data_dir",""))' "${INSTALL_JSON}" 2>/dev/null || true)"
    if [ -n "${had}" ] && [ -n "${A_CREW_DATA_DIR:-}" ] && [ "${had}" != "${A_CREW_DATA_DIR}" ]; then
        doc fail "already there" "an installation of Crew with the data folder ${had}"
        return 0
    fi
    doc ok "already there" "an installation of Crew: this is a repair or an update"
    done="$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("version",""))' "${INSTALL_JSON}" 2>/dev/null || true)"
    if [ -z "${done}" ]; then
        doc warn install "it stopped before it finished: crew-ctl install goes on from where it stopped"
        return 0
    fi
    have docker || return 0
    for c in "${CONTAINERS[@]}"; do docker ps --format '{{.Names}}' 2>/dev/null | grep -x "${c}" >/dev/null || down+=("${c}"); done
    [ ${#down[@]} = 0 ] || doc warn services "${done} is installed, but not running: ${down[*]}"
}

# The server and the ingress join the sandboxes' and the hosted projects' bridges, so they forward
# nothing (13.6, since 0.83): Compose starts them so once a release's deploy files that say it are in
# place, and an update recreates them. A server that forwards starts no sandbox. Doctor alone checks
# it, so an install that would recreate them is not refused for it.
doctor_forwarding() {
    [ -f "${INSTALL_JSON}" ] && have docker || return 0
    local c got
    for c in crew-server crew-caddy; do
        docker ps --format '{{.Names}}' 2>/dev/null | grep -x "${c}" >/dev/null || continue
        got="$(docker inspect -f '{{index .HostConfig.Sysctls "net.ipv4.ip_forward"}}' "${c}" 2>/dev/null || true)"
        if [ "${got}" = 0 ]; then doc ok forwarding "${c} is started with net.ipv4.ip_forward=0"
        else doc fail forwarding "${c} is not started with net.ipv4.ip_forward=0: put the deploy files of a release that sets it in place before its update (crew-ctl install --deploy-files --version X.Y.Z, as root), and the update recreates it"; fi
    done
    # The override is the operator's, in the install file (13.6): said while it is set, whatever runs.
    [ "${A_CREW_ALLOW_IP_FORWARD:-}" = 1 ] && doc warn forwarding "CREW_ALLOW_IP_FORWARD=1: the server starts sandboxes even when its network forwards (crew-ctl edit CREW_ALLOW_IP_FORWARD= takes it out)"
    return 0
}

# The tests check the answers alone: the machine's checks read the real machine and the network.
machine_checks() { doctor_installed; if [ "${CREW_CTL_TEST:-}" = 1 ] && [ "${CREW_CTL_TEST_NO_MACHINE:-}" = 1 ]; then return 0; fi; doctor_machine; }

cmd_doctor() {
    DOC_RESULTS=()
    # The answers first, so the installation found is compared with the data folder they give.
    local answers=0
    if [ -n "${ENV_IN}" ] || [ -f "${ENV_FILE}" ]; then answers=1; load_answers; fi
    machine_checks
    doctor_forwarding
    if [ "${answers}" = 1 ]; then
        doctor_answers
    else
        A_CREW_TLS=acme
        doc skip answers "no answers given: the machine alone was checked"
    fi
    doctor_print
}

# ─── Install (16.11) ────────────────────────────────────────────────────────
resolve_version() { # a tag builds that version; no tag builds 0.0.0-dev.<commit>
    local repo="$1" tag commit
    tag="$(git -C "${repo}" describe --tags --exact-match 2>/dev/null || true)"
    if [[ "${tag}" =~ ^v([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then echo "${BASH_REMATCH[1]}"; return; fi
    commit="$(git -C "${repo}" rev-parse --short=12 HEAD 2>/dev/null)" || die "${repo} is not a git checkout"
    echo "0.0.0-dev.${commit}"
}

write_env() { # writes the answers to crew.env, root only
    local tmp k v
    run install -d -m 0700 -o root -g root "${ETC_DIR}"
    if [ "${DRY}" = 1 ]; then echo "+ write ${ENV_FILE} (mode 600)"; return; fi
    tmp="$(mktemp "${ETC_DIR}/.crew.env.XXXXXX")"
    {
        echo "# Crew's install file, written by crew-ctl. Change a value with: crew-ctl edit KEY=VALUE"
        for k in "${KEYS_REQUIRED[@]}" "${KEYS_OPTIONAL[@]}"; do v="A_${k}"; echo "${k}=${!v}"; done
    } > "${tmp}"
    chmod 600 "${tmp}"
    mv -f "${tmp}" "${ENV_FILE}"
}

make_secrets() { # makes only what is missing: a key file or a password that is there is never replaced
    local s uid gid
    uid="$(crew_id -u)"; gid="$(crew_id -g)"
    run install -d -m 0700 -o root -g root "${SECRETS_DIR}"
    for s in "${SECRETS[@]}"; do
        if [ -s "${SECRETS_DIR}/${s}" ]; then continue; fi
        if [ "${DRY}" = 1 ]; then echo "+ make ${SECRETS_DIR}/${s}"; continue; fi
        ( umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "${SECRETS_DIR}/${s}" )
        log "made ${SECRETS_DIR}/${s}"
    done
    if [ ! -s "${ETC_DIR}/secret.key" ]; then
        if [ "${DRY}" = 1 ]; then echo "+ make ${ETC_DIR}/secret.key"
        else ( umask 077; head -c 32 /dev/urandom > "${ETC_DIR}/secret.key" ); log "made ${ETC_DIR}/secret.key"; fi
    fi
    # The containers run as crew, and read them as Docker secrets.
    run chown "${uid}:${gid}" "${ETC_DIR}/secret.key" "${SECRETS[@]/#/${SECRETS_DIR}/}"
    run chmod 0400 "${ETC_DIR}/secret.key" "${SECRETS[@]/#/${SECRETS_DIR}/}"
    write_answer_secrets
}

write_answer_secrets() { # the answers' secrets as files, so the ingress gets them as Docker secrets
    local pair file key v uid gid
    uid="$(crew_id -u)"; gid="$(crew_id -g)"
    run install -d -m 0700 -o root -g root "${SECRETS_DIR}"
    for pair in "${ANSWER_SECRETS[@]}"; do
        file="${SECRETS_DIR}/${pair%%:*}"; key="A_${pair#*:}"; v="${!key}"
        if [ "${DRY}" = 1 ]; then echo "+ write ${file}"; continue; fi
        ( umask 077; printf '%s' "${v}" > "${file}.tmp" )
        chown "${uid}:${gid}" "${file}.tmp" && chmod 0400 "${file}.tmp" && mv -f "${file}.tmp" "${file}"
    done
}

# crew_id -u|-g: the system user crew's id. Every container runs as it, so a missing user stops
# crew-ctl: it never falls back to root. A dry run before the user exists shows a placeholder.
crew_id() {
    if id "$1" crew >/dev/null 2>&1; then id "$1" crew; return; fi
    [ "${DRY}" = 1 ] && { echo "<crew>"; return; }
    die "the system user crew is missing: crew-ctl install makes it"
}

# docker_gid: the group of Docker's socket, which the server's container is given (13.8).
docker_gid() {
    local g; g="$(stat -c %g /var/run/docker.sock 2>/dev/null)"
    if [ -n "${g}" ]; then echo "${g}"; return; fi
    [ "${DRY}" = 1 ] && { echo "<docker>"; return; }
    die "Docker's socket /var/run/docker.sock is missing"
}

compose() { # compose ARGS...: the stack, with the install file and versions.lock
    local uid gid
    uid="$(crew_id -u)"; gid="$(crew_id -g)"
    CREW_VERSION="${CREW_VERSION:-$(installed_version)}" CREW_UID="${uid}" CREW_GID="${gid}" \
    CREW_UPDATER_VERSION="${CREW_UPDATER_VERSION:-$(updater_state updater)}" \
    CREW_ETC="${ETC_DIR}" CREW_DOCKER_GID="$(docker_gid)" \
        run docker compose -p crew -f "${LIB_DIR}/compose.yaml" \
            --env-file "${LIB_DIR}/versions.lock" --env-file "${ENV_FILE}" "$@"
}

# The version that runs is the updater's to say once it has switched one (16.4); before, install's.
installed_version() {
    local v; v="$(updater_state running)"
    [ -n "${v}" ] && { echo "${v}"; return; }
    [ -f "${INSTALL_JSON}" ] && python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("version",""))' "${INSTALL_JSON}" 2>/dev/null || true
}

# data_dir is the data folder install recorded, else the install file's, else the default.
data_dir() {
    local d=""
    [ -f "${INSTALL_JSON}" ] && d="$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("data_dir",""))' "${INSTALL_JSON}" 2>/dev/null || true)"
    [ -n "${d}" ] || { [ -f "${ENV_FILE}" ] && d="$(env_get "${ENV_FILE}" CREW_DATA_DIR)"; }
    echo "${d:-/var/lib/crew}"
}

updater_state() { # updater_state KEY: a value of the updater's state.json, '' when there is none
    local f; f="$(data_dir)/updater/state.json"
    [ -f "${f}" ] || return 0
    python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2],""))' "${f}" "$1" 2>/dev/null || true
}

# write_updater_state RUNNING: the version install started, with the one before it, for the updater
# to go on from (16.4). crew-ctl writes it only at install; afterwards it is the updater's.
write_updater_state() {
    local f; f="$(data_dir)/updater/state.json"
    [ "${DRY}" = 1 ] && { echo "+ record in ${f}: running $1"; return; }
    run install -d -m 0700 -o "$(crew_id -u)" -g "$(crew_id -g)" "$(dirname "${f}")"
    python3 -I - "${f}" "$1" <<'PY'
import json, os, sys, tempfile
path, running = sys.argv[1], sys.argv[2]
d = json.load(open(path)) if os.path.exists(path) else {}
if d.get("running") and d.get("running") != running:
    d["previous"] = d["running"]
d["running"] = running
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w") as f:
    json.dump(d, f, indent=2, sort_keys=True)
os.chmod(tmp, 0o640)
os.replace(tmp, path)
PY
}

record_json() { # record_json KEY VALUE...: merges facts into install.json
    [ "${DRY}" = 1 ] && { echo "+ record in ${INSTALL_JSON}: $*"; return; }
    python3 -I - "${INSTALL_JSON}" "$@" <<'PY'
import json, os, sys, tempfile
path, args = sys.argv[1], sys.argv[2:]
d = json.load(open(path)) if os.path.exists(path) else {}
for k, v in zip(args[0::2], args[1::2]):
    d[k] = json.loads(v) if v[:1] in ("[", "{") else v
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w") as f:
    json.dump(d, f, indent=2, sort_keys=True)
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PY
}

merge_host_record() { # turns host-setup's record into install.json, never changing "installed" to "found"
    local rec="$1"
    [ "${DRY}" = 1 ] && return
    python3 -I - "${INSTALL_JSON}" "${rec}" <<'PY'
import json, os, sys, tempfile
path, rec = sys.argv[1], sys.argv[2]
d = json.load(open(path)) if os.path.exists(path) else {}
parts = d.setdefault("machine", {})
lists = {"package", "unit", "file", "kernel_setting", "kata_dir"}
for line in open(rec):
    key, _, value = line.rstrip("\n").partition(" ")
    if key in lists:
        parts.setdefault(key + "s", [])
        if value not in parts[key + "s"]:
            parts[key + "s"].append(value)
        if key == "kata_dir" and value in parts.get("kata_dirs_gone", []):
            parts["kata_dirs_gone"].remove(value)
    elif key == "kata_dir_gone":
        # A folder of Kata the host setup removed is no longer Crew's to remove (13.2), also 3.31's, which
        # "installed 3.x" would otherwise name for good (security review of 0001b6a).
        parts["kata_dirs"] = [d for d in parts.get("kata_dirs", []) if d != value]
        gone = parts.setdefault("kata_dirs_gone", [])
        if value not in gone:
            gone.append(value)
    elif key == "daemon_json":
        prev = parts.setdefault("daemon_json", {})
        for k, v in json.loads(value).items():
            prev.setdefault(k, v)   # the value before Crew's first change is the one to put back
    elif key in ("docker", "kata", "user"):
        old = parts.get(key, "")
        if old.startswith(("installed", "created")) and value.startswith(("found",)):
            continue
        parts[key] = value
    else:
        parts[key] = value
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w") as f:
    json.dump(d, f, indent=2, sort_keys=True)
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PY
}

copy_deploy_files() { # what crew-ctl needs after install, without the checkout
    run install -d -m 0755 "${LIB_DIR}" "${LIB_DIR}/db" "${LIB_DIR}/lib" "${LIB_DIR}/firewall"
    run install -m 0644 "${REPO}/deploy/compose.yaml" "${REPO}/versions.lock" "${LIB_DIR}/"
    run install -m 0755 "${REPO}/deploy/db/10-roles.sh" "${LIB_DIR}/db/"
    run install -m 0755 "${REPO}/deploy/host-setup.sh" "${REPO}/deploy/proof.sh" "${REPO}/deploy/release.sh" "${LIB_DIR}/"
    run install -m 0644 "${REPO}/deploy/lib/"* "${LIB_DIR}/lib/"
    run install -m 0644 "${REPO}/deploy/firewall/"* "${LIB_DIR}/firewall/"
    run install -m 0755 "${REPO}/deploy/crew-ctl" "${SBIN_DIR}/crew-ctl"
}

# ─── The deploy files (16.11, since 0.55) ──────────────────────────────────
# An update replaces the containers, not crew-ctl and its files, which are root's. Install records the
# hash of each file it put in place, by its path in the repository, in install.json and, for Versions,
# in the releases folder, which the server reads. Every run of crew-ctl compares the files in place with
# the running release's deploy archive, and says the one command that puts the release's own in place.
DEPLOY_RECORD=deploy-files.json

# deploy_hashes ROOT: the deploy files of a tree, as the deploy archive holds them (release.DeployFiles),
# each with the hash of the file install puts in place for it, "-" when there is none: "PATH SHA256".
deploy_hashes() {
    python3 -I - "$1" "${LIB_DIR}" "${SBIN_DIR}" <<'PY'
import hashlib, os, sys
root, lib, sbin = sys.argv[1:4]
paths = ["deploy/crew-ctl", "deploy/release.sh", "deploy/host-setup.sh", "deploy/proof.sh", "deploy/compose.yaml", "versions.lock"]
for d in ("deploy/db", "deploy/lib", "deploy/firewall"):
    for dirpath, _, files in os.walk(os.path.join(root, d)):
        paths += [os.path.relpath(os.path.join(dirpath, f), root) for f in files]
def target(p):
    if p == "deploy/crew-ctl":
        return os.path.join(sbin, "crew-ctl")
    if p == "versions.lock":
        return os.path.join(lib, "versions.lock")
    return os.path.join(lib, p[len("deploy/"):])
for p in sorted(paths):
    try:
        with open(target(p), "rb") as f:
            print(p, hashlib.sha256(f.read()).hexdigest())
    except OSError:
        print(p, "-")
PY
}

# record_deploy_files: after the deploy files of REPO were put in place, the hash of each goes into
# install.json and into the releases folder, where Versions reads it.
record_deploy_files() {
    local dir; dir="$(data_dir)/releases"
    [ "${DRY}" = 1 ] && { echo "+ record the hashes of the deploy files in ${INSTALL_JSON} and ${dir}/${DEPLOY_RECORD}"; return 0; }
    local files
    # Each step returns on its failure: install calls this under ||, where errexit does not hold.
    files="$(deploy_hashes "${REPO}" | python3 -I -c 'import json, sys; print(json.dumps(dict(l.split(" ", 1) for l in sys.stdin.read().splitlines() if l), sort_keys=True))')" || return 1
    [ -n "${files}" ] || return 1
    record_json deploy_files "${files}" || return 1
    install -d -m 0755 "${dir}" || return 1
    printf '%s' "${files}" | python3 -I -c '
import json, os, sys, tempfile
path = sys.argv[1]
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
os.fchmod(fd, 0o644)
with os.fdopen(fd, "w") as f:
    json.dump({"files": json.load(sys.stdin)}, f, indent=2, sort_keys=True)
os.replace(tmp, path)' "${dir}/${DEPLOY_RECORD}"
}

# deploy_py MODE ARGS...: the one reader of a release's deploy archive, as root, with python3 -I
# (nothing of the caller's folder is imported). It reads an archive of at most 64 MiB once, decompresses
# at most 256 MiB of it, and takes only the deploy files' own names (the fixed list, and one name of
# letters, digits, dots, dashes and underscores under deploy/db, deploy/lib, deploy/firewall), regular
# files of at most 16 MiB each; it never follows a link in place.
#   compare ARCHIVE LIB SBIN: the paths whose file in place differs, one a line
#   unpack ARCHIVE DIR: writes those files under DIR
#   verify FOLDER RUNNING: the archive against release.json, release.json against a gate that passed,
#     of its version, whose live part is not pending or failed; with no gate, a build by hand, and only
#     the running release. It prints how it checked, or fails with why.
#   take FOLDER RUNNING DIR: verify, then unpack the very bytes it checked
deploy_py() {
    python3 -I - "$@" <<'PY'
import gzip, hashlib, io, json, os, posixpath, re, stat, sys, tarfile
MAX, ARCHIVE_MAX, UNPACKED_MAX = 16 << 20, 64 << 20, 256 << 20
FIXED = {"deploy/crew-ctl", "deploy/release.sh", "deploy/host-setup.sh", "deploy/proof.sh", "deploy/compose.yaml", "versions.lock"}
NAME = re.compile(r"[A-Za-z0-9._-]+")
def allowed(name):
    if name in FIXED:
        return True
    parts = name.split("/")
    return (len(parts) == 3 and parts[0] == "deploy" and parts[1] in ("db", "lib", "firewall")
            and NAME.fullmatch(parts[2]) is not None and parts[2] not in (".", ".."))
class Capped(io.RawIOBase):
    def __init__(self, f):
        self.f, self.n = f, 0
    def readable(self):
        return True
    def readinto(self, b):
        n = self.f.readinto(b)
        self.n += n
        if self.n > UNPACKED_MAX:
            raise ValueError("the deploy archive unpacks to more than 256 MiB")
        return n
def load(archive):
    with open(archive, "rb") as f:
        data = f.read(ARCHIVE_MAX + 1)
    if len(data) > ARCHIVE_MAX:
        raise ValueError("the deploy archive is larger than 64 MiB")
    return data
def members(data):
    raw = io.BufferedReader(Capped(gzip.GzipFile(fileobj=io.BytesIO(data))))
    with tarfile.open(fileobj=raw, mode="r|") as t:
        for m in t:
            if m.isreg() and allowed(m.name) and m.size <= MAX:
                yield m.name, t.extractfile(m).read(MAX + 1)
def target(p, lib, sbin):
    if p == "deploy/crew-ctl":
        return os.path.join(sbin, "crew-ctl")
    if p == "versions.lock":
        return os.path.join(lib, "versions.lock")
    return os.path.join(lib, p[len("deploy/"):])
def in_place(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > MAX:
            return None
        h = hashlib.sha256()
        while chunk := os.read(fd, 1 << 16):
            h.update(chunk)
        return h.hexdigest()
    finally:
        os.close(fd)
def unpack(data, out):
    for name, body in members(data):
        dst = os.path.join(out, name)
        os.makedirs(os.path.dirname(dst), mode=0o700, exist_ok=True)
        fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(body)
def verify(folder, running):
    with open(os.path.join(folder, "release.json"), "rb") as f:
        body = f.read(1 << 20)
    m = json.loads(body)
    v = m.get("version")
    if v != os.path.basename(os.path.normpath(folder)):
        sys.exit("release.json is of another version than its folder")
    d = m.get("deploy") or {}
    if d.get("file") != "deploy.tar.gz" or not d.get("sha256"):
        sys.exit("release.json names no deploy archive")
    data = load(os.path.join(folder, "deploy.tar.gz"))
    if hashlib.sha256(data).hexdigest() != d["sha256"]:
        sys.exit("the deploy archive is not the one release.json names")
    try:
        with open(os.path.join(folder, "gate.json"), "rb") as f:
            g = json.loads(f.read(1 << 20))
    except FileNotFoundError:
        if m.get("byHand") is True and v == running:
            return "no gate: a release by hand, the running one", data
        sys.exit("no gate passed it, and it is not the running release by hand")
    if g.get("manifestSha256") != hashlib.sha256(body).hexdigest():
        sys.exit("gate.json was written for another release.json")
    if g.get("version") != v or g.get("passed") is not True or g.get("live", "") not in ("", "passed", "skipped"):
        sys.exit("its gate did not pass")
    return "gated", data
mode, args = sys.argv[1], sys.argv[2:]
try:
    if mode == "compare":
        archive, lib, sbin = args
        for name, body in members(load(archive)):
            if in_place(target(name, lib, sbin)) != hashlib.sha256(body).hexdigest():
                print(name)
    elif mode == "unpack":
        archive, out = args
        unpack(load(archive), out)
    elif mode == "verify":
        print(verify(*args)[0])
    elif mode == "take":
        folder, running, out = args
        how, data = verify(folder, running)
        unpack(data, out)
        print(how)
except (OSError, ValueError, tarfile.TarError, EOFError) as e:
    sys.exit(str(e))
PY
}

# deploy_files_behind: one line on stderr when the deploy files in place are not those of the running
# release's deploy archive, with the command for root, this crew-ctl's install --deploy-files; a
# warning instead when the archive does not check. Nothing when they are the same, or when there is
# nothing to compare with. It changes nothing, and never fails the run.
deploy_files_behind() {
    [ -f "${INSTALL_JSON}" ] || return 0
    local v folder differ how self
    v="$(installed_version)"
    valid_version "${v}" || return 0
    folder="$(data_dir)/releases/${v}"
    [ -f "${folder}/deploy.tar.gz" ] || return 0
    if ! differ="$(deploy_py compare "${folder}/deploy.tar.gz" "${LIB_DIR}" "${SBIN_DIR}" 2>&1)"; then
        warn "the deploy archive of ${v} cannot be read: $(printable "${differ}" | tail -c 300)"
        return 0
    fi
    [ -n "${differ}" ] || return 0
    if ! how="$(deploy_py verify "${folder}" "${v}" 2>&1)"; then
        warn "crew-ctl and its files are not those of the running release ${v}, and its release folder does not check ($(printable "${how}" | tail -c 200)): Crew offers no command"
        return 0
    fi
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    echo "==> crew-ctl and its files are not those of the running release ${v} ($(grep -c . <<<"${differ}") differ, $(printable "$(head -1 <<<"${differ}")") first). As root: $(printf '%q' "${self}") install --deploy-files" >&2
}

# install_deploy_files: install --deploy-files. The running release's deploy files, or those of
# --version, checked against its release.json and gate.json, unpacked by their names alone into a
# folder of mktemp, put in place by this crew-ctl, and recorded, with the running release's version in
# install.json; nothing else is changed. A release whose archive or gate does not check is refused with
# nothing changed.
install_deploy_files() {
    { [ "${BUILD}" = 0 ] && [ "${UPGRADE}" = 0 ] && [ -z "${FROM_DIR}" ]; } || die "install --deploy-files takes no --build, --upgrade-runtime or --from"
    [ -f "${INSTALL_JSON}" ] || die "Crew is not installed: install --deploy-files puts in place the files of an installed Crew"
    local v folder how
    v="${VERSION_ARG:-$(installed_version)}"
    valid_version "${v}" || die "no release to take the deploy files of: give --version X.Y.Z"
    folder="$(data_dir)/releases/${v}"
    REPO="$(mktemp -d)"
    if ! how="$(deploy_py take "${folder}" "$(installed_version)" "${REPO}" 2>&1)"; then
        rm -rf "${REPO}"
        die "the release folder of ${v} does not check ($(printable "${how}" | tail -c 200)); nothing was changed"
    fi
    # Every file the copy names, before the first is put in place.
    local f missing=""
    for f in deploy/crew-ctl deploy/release.sh deploy/host-setup.sh deploy/proof.sh deploy/compose.yaml deploy/db/10-roles.sh versions.lock; do
        [ -f "${REPO}/${f}" ] || missing="${f}"
    done
    compgen -G "${REPO}/deploy/lib/*" >/dev/null || missing=deploy/lib
    compgen -G "${REPO}/deploy/firewall/*" >/dev/null || missing=deploy/firewall
    if [ -n "${missing}" ]; then
        rm -rf "${REPO}"
        die "the deploy archive of ${v} holds no ${missing}; nothing was changed"
    fi
    copy_deploy_files
    record_deploy_files
    # Install's record names the release it put in, and an update leaves it so: the running release's
    # files make it name that one. An install that stopped half way stays unmarked, for doctor to say.
    local had
    had="$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("version",""))' "${INSTALL_JSON}" 2>/dev/null || true)"
    if [ -n "${had}" ] && [ "${had}" != "${v}" ] && [ "${v}" = "$(updater_state running)" ]; then
        record_json version "${v}"
    fi
    rm -rf "${REPO}"
    log "crew-ctl and its files are those of ${v} (${how}); nothing else was changed"
}

build_one() { # build_one TAG DOCKERFILE CONTEXT [TARGET [ARGS...]]: the whole output goes to a log, its end on failure; TARGET "" is none
    local tag="$1" file="$2" ctx="$3" target=() out
    [ -z "${4:-}" ] || target=(--target "$4")
    shift 3; shift || true
    [ "${DRY}" = 1 ] && { echo "+ docker build -f ${file} ${target[*]} $* -t ${tag} ${ctx}"; return; }
    out="$(mktemp)"
    if docker build --progress=plain -f "${file}" "${target[@]}" "$@" --build-arg "CREW_VERSION=${tag##*:}" -t "${tag}" "${ctx}" > "${out}" 2>&1; then
        log "built ${tag}"; rm -f "${out}"
    else
        tail -60 "${out}" >&2; rm -f "${out}"
        die "the build of ${tag} failed (its last lines are above)"
    fi
}

build_images() {
    local v="$1" agy
    log "building the images of ${v} from ${REPO}"
    build_one "crew-server:${v}" "${REPO}/deploy/Dockerfile.server" "${REPO}"
    build_one "crew-caddy:${v}" "${REPO}/ingress/Dockerfile" "${REPO}/ingress"
