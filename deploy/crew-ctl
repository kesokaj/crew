# AGY_TARBALL is the whole shape of agy's tarball's address, with its version as the first group: the
# vendor's bucket and no other, as the adapter (internal/cli/agy.go) and tools/check-versions.py hold
# it. AGY_MAX bounds the download (62 MiB at 1.4.5).
AGY_TARBALL='^https://storage\.googleapis\.com/antigravity-public/antigravity-cli/([0-9]+\.[0-9]+\.[0-9]+)-[0-9]+/linux-x64/cli_linux_x64\.tar\.gz$'
AGY_MAX=536870912

# agy_folder: a new folder for agy's tarball; in a dry run only its name.
agy_folder() { if [ "${DRY}" = 1 ]; then echo "<a folder of mktemp>"; else mktemp -d; fi; }

# fetch_agy LOCK DIR: agy's tarball as the versions.lock LOCK pins it, into DIR/cli_linux_x64.tar.gz,
# which the runtime image copies from its build context agy (12.8, since 0.57). The address must be the
# vendor's with AGY_VERSION in it, in a dry run too; the download is https only and follows no
# redirect, sends nothing that names this machine, is cut past AGY_MAX bytes also when the answer gives
# no length, and is kept only with the pin's sha512. A refusal leaves no file and names no value of
# the lock, which a commit wrote.
fetch_agy() {
    local lock="$1" dir="$2" v url sum file status
    v="$(sed -n 's/^AGY_VERSION=//p' "${lock}" | tail -1)"
    url="$(sed -n 's/^AGY_URL=//p' "${lock}" | tail -1)"
    sum="$(sed -n 's/^AGY_SHA512=//p' "${lock}" | tail -1)"
    if ! [[ "${url}" =~ ${AGY_TARBALL} ]] || [ "${BASH_REMATCH[1]}" != "${v}" ]; then
        echo "crew-ctl: ERROR versions.lock: AGY_URL is not the address of the vendor's tarball at AGY_VERSION" >&2; return 1
    fi
    [[ "${sum}" =~ ^[0-9a-f]{128}$ ]] || { echo "crew-ctl: ERROR versions.lock: AGY_SHA512 is not a sha512 checksum" >&2; return 1; }
    file="${dir}/cli_linux_x64.tar.gz"
    if [ "${DRY}" = 1 ]; then
        echo "+ curl --proto =https --max-redirs 0 ${url} into ${file}, at most ${AGY_MAX} bytes, checked by its sha512"
        return 0
    fi
    install -d -m 0755 "${dir}" || return 1
    log "downloading agy ${v}"
    # -q first: root's ~/.curlrc adds nothing, a header naming the machine neither.
    if ! curl -q -sS --proto '=https' --max-redirs 0 --max-time 600 -D "${dir}/headers" "${url}" | head -c "$((AGY_MAX + 1))" > "${file}"; then
        rm -f -- "${file}" "${dir}/headers"
        echo "crew-ctl: ERROR agy's tarball: the download failed, or was more than ${AGY_MAX} bytes" >&2; return 1
    fi
    # The vendor's answer is the last status line: behind a proxy, the CONNECT's 200 comes first.
    status="$(tr -d '\r' < "${dir}/headers" | grep '^HTTP/' | tail -1)"; rm -f -- "${dir}/headers"
    if ! [[ "${status}" =~ ^HTTP/[0-9.]+\ 200( |$) ]]; then
        rm -f -- "${file}"
        echo "crew-ctl: ERROR agy's tarball: the vendor's address answered $(printable "${status#* }" | head -c 40), not 200" >&2; return 1
    fi
    if [ "$(stat -c %s "${file}")" -gt "${AGY_MAX}" ]; then
        rm -f -- "${file}"
        echo "crew-ctl: ERROR agy's tarball: the answer is more than ${AGY_MAX} bytes" >&2; return 1
    fi
    if ! echo "${sum}  ${file}" | sha512sum -c --status -; then
        rm -f -- "${file}"
        echo "crew-ctl: ERROR agy's tarball is not the one versions.lock pins: its sha512 differs" >&2; return 1
    fi
}

wait_healthy() { # wait_healthy CONTAINER SECONDS
    [ "${DRY}" = 1 ] && return 0
    local st
    for _ in $(seq 1 "$2"); do
        st="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$1" 2>/dev/null || true)"
        [ "${st}" = healthy ] && return 0
        sleep 1
    done
    die "$1 is not healthy after $2 seconds (crew-ctl logs)"
}

ADMIN_ENV=()
