# Crew: the answers the installer needs.
#
# Copy this file, fill it in, and give it to the installer:
#   sudo deploy/crew-ctl install --build --env-file my.env
# Without a file, the installer asks for each value when it starts.
# The installer checks the answers and writes them to /etc/crew/crew.env,
# which only root can read. Change a value later with: crew-ctl edit
#
# Everything secret that is not asked for here is generated by the installer:
# the key file, the database passwords, the session key, and the secret that
# the ingress and the server share.
# Logins for the agents (git, GitHub, gcloud, the agent CLI, mail) are not set
# here. You set them up in Setup, the first screen of the app.

# --- must be given -----------------------------------------------------------

# The address Crew is opened at. The sign-in page is at auth.<CREW_HOSTNAME>.
# Both names must point at this machine, unless CLOUDFLARE_API_TOKEN is set.
CREW_HOSTNAME=crew.example.com

# The one Google account that may sign in. Also the contact for certificates.
CREW_ADMIN_EMAIL=you@example.com

# A Google sign-in client: Google Cloud console, APIs and Services,
# Credentials, OAuth client ID, type "Web application".
# Authorised redirect address:
#   https://auth.<CREW_HOSTNAME>/oauth2/google/authorization-code-callback
# and, if you host projects, also:
#   https://auth.<CREW_APPS_DOMAIN>/oauth2/google/authorization-code-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- may be given ------------------------------------------------------------

# The domain hosted projects get their addresses under: <project>.<this>.
# It must not be CREW_HOSTNAME or a domain under or over it (e.g. apps.example.com
# beside crew.example.com, or another domain): Crew hosts nothing while it is empty,
# Crew's own address, or a name under or over it. Leave empty if you do not host projects.
CREW_APPS_DOMAIN=

# A Cloudflare API token that may edit DNS in the zones above.
# With it the ingress writes the DNS records and gets the certificates,
# also the wildcard certificate for hosted projects.
# Without it you set the DNS records yourself.
CLOUDFLARE_API_TOKEN=

# Where certificates come from:
#   acme      real certificates (the default)
#   staging   test certificates of the same service
#   internal  certificates the ingress makes itself. For a test machine only:
#             the names and the sign-in client are then not checked.
CREW_TLS=acme

# Where Crew keeps its data.
CREW_DATA_DIR=/var/lib/crew

# The time zone for quiet hours and every time shown. Empty: the machine's own.
CREW_TIMEZONE=

# The repository this installation builds Crew from and pushes its own
# changes to, as owner/name. It is only a first value: Setup asks for it
# and checks it once the SSH key exists. Example: your-org/crew
CREW_SOURCE_REPO=

# Leave empty. 1 lets the server start sandboxes even when its network
# namespace forwards between bridges, or cannot be read (design 13.6): only
# for a machine where that is known and wanted. doctor warns while it is 1.
CREW_ALLOW_IP_FORWARD=
